#!/usr/bin/env bash
# sv0-toolchain pre-push hook — complete verification, scoped to what the push changes.
#   * parent repo : ./scripts/sv0 test         (units + C/VM integration + self-host
#                   sv0 loop + goldens + doctests + all guards)
#                   ./scripts/sv0 test-light   when EVERY changed path is docs/task data
#                   or a library-submodule bump (guards + doctests + the stages that
#                   submodule feeds) -- see scripts/prepush_scope.py
#   * sv0c submodule: make check test          (sv0c's own CI-equivalent suite);
#                   skipped when only docs changed
#
# The scope decision is conservative: any changed path the classifier does not
# explicitly recognise as cheap runs the FULL suite. Branch deletions and pushes
# that add no new file changes (e.g. tag-only) run nothing.
#
# Installed for BOTH repos by scripts/install-git-hooks.sh.
# Source of truth: scripts/git-hooks/ (tracked).
# Bypass: git push --no-verify   (or SV0_SKIP_HOOKS=1)
# Force the full suite regardless of scope: SV0_PREPUSH_FULL=1
set -euo pipefail

[[ -n "${SV0_SKIP_HOOKS:-}" ]] && { echo "pre-push: SV0_SKIP_HOOKS set — skipping tests" >&2; exit 0; }

repo_top="$(git rev-parse --show-toplevel)"

if [[ -f "$repo_top/scripts/sv0" ]]; then
  kind=parent
  toolchain_root="$repo_top"
elif [[ -f "$repo_top/Makefile" && "$(basename "$repo_top")" == "sv0c" ]]; then
  kind=sv0c
  toolchain_root="$(cd "$repo_top/.." && pwd)"
else
  echo "pre-push: unrecognized repo at $repo_top; skipping (no tests run)" >&2
  exit 0
fi

# ---- decide scope from the refs being pushed (stdin: <lref> <lsha> <rref> <rsha>) ----
scope=full
if [[ -z "${SV0_PREPUSH_FULL:-}" && -f "$toolchain_root/scripts/prepush_scope.py" ]]; then
  paths_file="$(mktemp)"
  trap 'rm -f "$paths_file"' EXIT
  any_ref=0
  unknown=0
  while read -r _lref local_sha _rref remote_sha; do
    [[ -z "${local_sha:-}" ]] && continue
    [[ "$local_sha" =~ ^0+$ ]] && continue            # branch/tag deletion: nothing to test
    any_ref=1
    base="$remote_sha"
    if [[ "$base" =~ ^0+$ ]] || ! git cat-file -e "${base}^{commit}" 2>/dev/null; then
      # new ref / remote tip not present locally: compare against the default branch
      base="$(git merge-base "$local_sha" origin/main 2>/dev/null || true)"
    fi
    if [[ -z "$base" ]]; then unknown=1; continue; fi
    git diff --name-only -z "$base" "$local_sha" >>"$paths_file"
  done
  if ((any_ref == 0)); then
    echo "pre-push: nothing to test (ref deletion / no refs)" >&2
    exit 0
  fi
  if ((unknown == 0)); then
    scope="$(python3 "$toolchain_root/scripts/prepush_scope.py" --repo "$kind" <"$paths_file" || echo full)"
  fi
fi

case "$scope" in
  skip)
    echo "pre-push: only docs/no-op changes — skipping tests (SV0_PREPUSH_FULL=1 to force)" >&2
    exit 0
    ;;
  light*)
    # shellcheck disable=SC2086
    groups="${scope#light}"
    echo "pre-push: docs/library-only push — running the light suite (./scripts/sv0 test-light$groups)" >&2
    # shellcheck disable=SC2086
    ( cd "$repo_top" && ./scripts/sv0 test-light $groups ) || {
      echo "pre-push: ./scripts/sv0 test-light FAILED — push aborted. Fix tests or push --no-verify." >&2
      exit 1
    }
    ;;
  *)
    if [[ "$kind" == parent ]]; then
      echo "pre-push: running full test suite (./scripts/sv0 test) — this takes a few minutes..." >&2
      ( cd "$repo_top" && ./scripts/sv0 test ) || {
        echo "pre-push: ./scripts/sv0 test FAILED — push aborted. Fix tests or push --no-verify." >&2
        exit 1
      }
    else
      echo "pre-push: running sv0c suite (make check test)..." >&2
      ( cd "$repo_top" && make check test ) || {
        echo "pre-push: make check test FAILED — push aborted. Fix tests or push --no-verify." >&2
        exit 1
      }
    fi
    ;;
esac

echo "pre-push: tests passed." >&2
