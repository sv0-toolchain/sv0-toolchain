    'python3 "$ROOT/scripts/native_exe_human_output.py" --selftest'
    'python3 "$ROOT/scripts/native_exe_build.py" --selftest'
    'python3 "$ROOT/scripts/native_exe_behavior_corpus.py" --selftest'
    'python3 "$ROOT/scripts/native_exe_runtime_feature_smoke.py" --selftest'
    'python3 "$ROOT/scripts/native_exe_project_mode.py" --selftest'
    'python3 "$ROOT/scripts/native_exe_contract_mode.py" --selftest'
    'python3 "$ROOT/scripts/native_exe_preservation.py" --selftest'
    'python3 "$ROOT/scripts/native_exe_hardening_smoke.py" --selftest'
    'python3 "$ROOT/scripts/native_exe_parallel_builds.py" --selftest'
    'python3 "$ROOT/scripts/native_exe_hostile_paths.py" --selftest'
    'python3 "$ROOT/scripts/prepush_scope.py" --selftest'
    '"$ROOT/scripts/sv0" run-cache-selftest'
    'python3 "$ROOT/scripts/emit_cache_key.py" --selftest'
  )

  # SV0_GUARDS_FAST=1: only the cheap doc-pin / static guards. The native_exe_*
  # selftests each drive real builds (cc, sanitizers, ...) and only matter when
  # the native-exe driver, runtime or compiler changed; pre-commit uses this
  # for commits that touch none of those, and pre-push still runs everything.
  if [[ -n "${SV0_GUARDS_FAST:-}" ]]; then
    local -a fast_descs=() fast_cmds=()
    local gi
    for gi in "${!guard_cmds[@]}"; do
      case "${guard_cmds[$gi]}" in
        *'/scripts/native_exe_'*) ;;
        *) fast_descs+=("${guard_descs[$gi]}"); fast_cmds+=("${guard_cmds[$gi]}") ;;
      esac
    done
    guard_descs=("${fast_descs[@]}")
    guard_cmds=("${fast_cmds[@]}")
  fi

  local resultdir
  resultdir="$(mktemp -d)"
  printf '%s\n' "${guard_cmds[@]}" >"$resultdir/commands.txt"
  local njobs n
  njobs="$(sv0_jobs)"
  n=${#guard_cmds[@]}

  seq 1 "$n" \
    | SV0_GUARD_RESULTDIR="$resultdir" xargs -P "$njobs" -I{} bash -c '
        idx="$1"
        cmd="$(sed -n "${idx}p" "$SV0_GUARD_RESULTDIR/commands.txt")"
        if eval "$cmd" >"$SV0_GUARD_RESULTDIR/${idx}.log" 2>&1; then
          echo ok >"$SV0_GUARD_RESULTDIR/${idx}.status"
        else
          echo fail >"$SV0_GUARD_RESULTDIR/${idx}.status"
        fi
      ' _ {}

  # A handful of guards (e.g. native_exe_subprocess's process-group
  # cancellation case) assume their own background helper process gets
  # scheduled within a fixed real-time window -- a assumption N-way parallel
  # execution can occasionally violate under contention, even though the
  # guard is not actually broken. Retry each apparent failure once, alone
  # (no contention), before treating it as real: a genuine bug fails both
  # times; a scheduling flake only fails the first.
  local ec=0 i status cmd
  for ((i = 1; i <= n; i++)); do
    status="$(cat "$resultdir/${i}.status" 2>/dev/null || echo fail)"
    if [[ "$status" != "ok" ]]; then
      cmd="${guard_cmds[$((i - 1))]}"
      if eval "$cmd" >"$resultdir/${i}.log" 2>&1; then
        continue
      fi
      ec=1
      sv0_info "$label: ${guard_descs[$((i - 1))]}"
      echo "$label: FAILED (see log below)" >&2
      cat "$resultdir/${i}.log" >&2
    fi
  done
  rm -rf "$resultdir"
  return "$ec"
}

run_test_guards() {
  # Several native_exe_*.py selftests (native_exe_same_output_stress,
  # native_exe_benchmark, native_exe_warning_report, ...) drive real builds
  # through native_exe_build.py, which resolves the compiler binary at
  # build/sv0-megatu-native and never builds it itself -- it's the DRIVER,
  # not the compiler-builder, by this project's own established design.
  # On a fresh checkout (no build/ directory at all -- CI, or a first-ever
  # local run) those selftests failed outright with "executable not found",
  # a real, previously-invisible gap that only ever went unnoticed locally
  # because this session's own build/ directory has had the binary built
  # and persisted across dozens of manual runs all along. Ensure it exists
  # before any Python guard that needs it runs. NEX-031's own selftest
  # (native_exe_contract_mode.py) separately needs build/sv0-megatu-verify
  # (built by build-sv0-megatu-verify-native.sh) for the same reason.
  ensure_sv0_megatu_native
  ensure_sv0_megatu_verify
  if ! run_python_guards "sv0 test-guards"; then
    sv0_fail "sv0 test-guards: one or more Python checks failed"
  fi
  sv0_ok "sv0 test-guards: block-comment + sv0doc baseline + task YAML + task sv0-track + README sv0c gitlink + CV-002 sv0cov submodule pin + CV-104 sha256 generator + CV-102 coverage identifier registry + CV-106 coverage mode rules + vm-parity manifest ⊆ bootstrap + milestone-orientation + workspace milestone table + compiler sv0 no-raise + commit-msg AI-signoff selftest + M3 G1 slice path audit + M3 G6 pipeline contract + M3 G6 link merge contract + M3 G6 staging driver contract + M3 G7 diagnostics corpus layout + M3 G7 tier-2 VM parity policy + M3 G8 native recipe paths + M3 G9 retirement docs + M3 GX bootstrap policy docs + NEX-001 native-exe traceability + NEX-002 native-exe CLI parser selftest + NEX-003 native-exe phase-machine + request normalization selftests + NEX-004 fake emitter selftest + NEX-005 fake C compiler selftest + NEX-006 error phase mapping selftest + NEX-007/052b atomic publication + output lock + same-output stress selftest + NEX-008 scratch-dir lifecycle selftest + NEX-009/034 argv-only + cancellable subprocess selftest + NEX-011/055c core-compiler reentrant-request selftest + NEX-012 emission protocol selftest + NEX-013/014 entry existence+uniqueness scan selftest + NEX-015 entry signature selftest + NEX-017 reserved-symbol collision selftest + NEX-018/039 staging-C + emit-c selftest + NEX-040 keep-c retention selftest + NEX-041 JSON event encoder selftest + NEX-042 build-record selftest + NEX-043 sv0.toml config selftest + NEX-045 runtime bundle selftest + NEX-046 installed-layout E2E selftest + NEX-047 benchmark harness selftest + NEX-055a perf regression selftest + NEX-055b concurrent-perf selftest + NEX-056a release-evidence selftest + NEX-058 canonical-compile + no-duplicate-recipe guard selftest + NEX-055c no-new-legacy-control-file guard selftest + NEX-049a/b/c warning policy selftest + NEX-050a/b sanitizer build+matrix selftest + VM-compose phase-6 patch resilience selftest + NEX-050c full-corpus sanitizer sweep selftest + NEX-051b release parity selftest + NEX-053a reproducibility harness selftest + NEX-019 runtime resolver selftest + NEX-020 runtime manifest selftest + NEX-054a/b entry ABI manifest + compat + install-mismatch selftest + NEX-021 cc-selection selftest + NEX-022/044 cc-probe + cached-probe selftest + NEX-023/051a argv builder selftest + NEX-024 sanitized env selftest + NEX-025 host-compile diagnostics selftest + NEX-026 output-path rules selftest + NEX-027 human output selftest + NEX-028/051c build assembly + profile selection + behavior corpus smoke + NEX-029 runtime-feature coverage + NEX-030 project-mode build + NEX-031 contract-mode matrix + NEX-032 preservation across failure phases + NEX-033 symlink/scratch hardening + NEX-035 parallel builds + NEX-036 hostile paths"
}

# Reduced suite for pushes whose changed paths cannot affect the compiler, VM or
# runtime (see scripts/prepush_scope.py): every guard + doctests, plus the stages
# that consume the library submodules named as args (mathlib, strings).
run_test_light() {
  local ec=0 want_mathlib=0 want_strings=0 g
  for g in "$@"; do
    case "$g" in
      mathlib) want_mathlib=1 ;;
      strings) want_strings=1 ;;
      *) sv0_fail "test-light: unknown group '$g' (want: mathlib, strings)" ;;
    esac
  done
  ensure_sv0_megatu_native
  ensure_sv0_megatu_verify
  if ! run_python_guards "sv0 test-light"; then
    ec=1
  fi
  if [[ "$want_strings" -eq 1 ]]; then
    sv0_info "sv0 test-light: owned-string allocation fault injection (sv0-strings changed)"
    if ! python3 "$ROOT/scripts/verify_string_alloc_failure.py"; then
      ec=1
    fi
  fi
  if [[ "$want_mathlib" -eq 1 ]]; then
    require_sml
    sv0_info "sv0 test-light: VM behavioral parity (sv0-mathlib changed)"
    if ! python3 "$ROOT/scripts/vm_behavioral_parity.py"; then
      ec=1
    fi
  fi
  if [[ "$want_mathlib" -eq 1 || "$want_strings" -eq 1 ]]; then
    sv0_info "sv0 test-light: native --project acceptance (library submodule changed)"
    if ! run_native_project_acceptance; then
      ec=1
    fi
  fi
  if ! run_doctests; then
    ec=1
  fi
  if [[ "$ec" -ne 0 ]]; then
    sv0_fail "sv0 test-light: one or more stages failed (exit $ec)"
  fi
  sv0_ok "sv0 test-light: guards + doctests (mathlib=$want_mathlib strings=$want_strings)"
}

run_test() {
  local ec=0
  ensure_sv0_self_host_compiler
  # See run_test_guards's own comment: several native_exe_*.py selftests
  # inside run_python_guards need build/sv0-megatu-native (and NEX-031's own
  # selftest needs build/sv0-megatu-verify) to already exist on a fresh
  # checkout.
  ensure_sv0_megatu_native
  ensure_sv0_megatu_verify
  # PC-6c (native-default promotion): do NOT force the SML delegate as the default
  # here. Leaving SV0_SELF_HOST_COMPILER unset lets run_self_host_sv0_loop flip to
  # the native mega-TU binary (behavioral acceptance) as the promoted default, while
  # the stage0 golden gate pins the SML delegate itself. A user can still force a
  # specific compiler by exporting SV0_SELF_HOST_COMPILER before the run. The
  # delegate is built above (ensure_sv0_self_host_compiler) for the SML byte-guards.
  (cd "$SV0C" && make test) || ec=1
  if ! run_python_guards "sv0 test"; then
    ec=1
  fi
  require_sml
  sv0_info "sv0 test: diagnostics corpus behavioral (SML vs manifest needles)"
  if ! python3 "$ROOT/scripts/verify_diagnostics_corpus_behavior.py" --root "$ROOT"; then
    ec=1
  fi
  sv0_info "sv0 test: diagnostics corpus behavioral (native mega-TU vs manifest needles; BH-8)"
  if ! python3 "$ROOT/scripts/verify_diagnostics_corpus_behavior_native.py" --root "$ROOT"; then
    ec=1
  fi
  # (verify_behavior_corpus_native.py -- the hand-rolled emit+cc+run recipe over the
  # same manifest, asserting the same exit codes -- is no longer run here: the
  # canonical-driver sweep below is a strict superset of it (same rows, same
  # assertion, plus entry/staging validation), so running both only doubled the
  # cost. The script stays as a standalone tool.)
  sv0_info "sv0 test: behavioral PASS corpus via native_exe_build (NEX-028; TEST-004)"
  if ! python3 "$ROOT/scripts/native_exe_behavior_corpus.py" --root "$ROOT"; then
    ec=1
  fi
  sv0_info "sv0 test: behavioral PASS corpus — VM leg (SML --target=vm + sv0vm vs expected exit)"
  if ! python3 "$ROOT/scripts/verify_behavior_corpus_vm.py" --root "$ROOT"; then
    ec=1
  fi
  sv0_info "sv0 test: owned-string allocation fault injection (SS-U02d; UP-007)"
  if ! python3 "$ROOT/scripts/verify_string_alloc_failure.py"; then
    ec=1
  fi
  sv0_info "sv0 test: z3 driver (M4-S-011; verifies scripts/sv0-z3.sh, skips if z3 absent)"
  if ! python3 "$ROOT/scripts/verify_z3_driver.py" --root "$ROOT"; then
    ec=1
  fi
  sv0_info "sv0 test: sv0 verify e2e (M4-S-020; parse→VC→z3 on test/verify/basic.sv0, skips if z3 absent)"
  if ! python3 "$ROOT/scripts/verify_sv0_verify_e2e.py" --root "$ROOT"; then
    ec=1
  fi
  sv0_info "sv0 test: verify corpus (M4-S-040; expected status per contract in test/verify/corpus, skips if z3 absent)"
  if ! python3 "$ROOT/scripts/verify_corpus.py" --root "$ROOT"; then
    ec=1
  fi
  sv0_info "sv0 test: verify determinism (M4-S-014; identical statuses across repeated runs, skips if z3 absent)"
  if ! python3 "$ROOT/scripts/verify_determinism.py" --root "$ROOT"; then
    ec=1
  fi
  sv0_info "sv0 test: verified contract-mode (M4-S-023/024; proven ensures stripped in lowering, skips if z3 absent)"
  if ! python3 "$ROOT/scripts/verify_contract_mode.py" --root "$ROOT"; then
    ec=1
  fi
  sv0_info "sv0 test: sv0.toml contract-mode (M4-S-025; [build] contract-mode + flag override, skips if z3 absent)"
  if ! python3 "$ROOT/scripts/verify_contract_toml.py" --root "$ROOT"; then
    ec=1
  fi
  if ! (cd "$SV0VM" && echo 'use "src/main.sml"; use "test/bytecode_test.sml"; OS.Process.exit OS.Process.success;' | sml >/dev/null); then
    ec=1
  fi
  sv0_info "sv0 test: C backend integration (sv0c)"
  if ! bash "$ROOT/task/sv0c-milestone-1/02-integration-test.sh"; then
    ec=1
  fi
  sv0_info "sv0 test: VM pipeline integration"
  if ! bash "$ROOT/task/sv0vm-milestone-2/02-integration-test.sh"; then
    ec=1
  fi
  sv0_info "sv0 test: bootstrap-in-sv0 programs on VM"
  if ! run_bootstrap_build; then
    ec=1
  fi
  sv0_info "sv0 test: VM parity (SML bytecode vs golden/sml)"
  if ! run_vm_parity_sml_goldens; then
    ec=1
  fi
  sv0_info "sv0 test: VM parity tier-2 (optional emitter vs golden/sml)"
  if ! run_vm_parity_tier2_emit_compare; then
    ec=1
  fi
  sv0_info "sv0 test: VM behavioral parity (f64/i64: native emit-c vs VM-emit->sv0vm)"
  if ! python3 "$ROOT/scripts/vm_behavioral_parity.py"; then
    ec=1
  fi
  sv0_info "sv0 test: VM FFI gate (FFI-014 — raw-pointer/unsafe/extern_c programs rejected on VM, E0553)"
  if ! python3 "$ROOT/scripts/verify_vm_ffi_gate.py"; then
    ec=1
  fi
  sv0_info "sv0 test: FFI regression corpus (FFI-015 — E0550/E0551/E0552/E0553 never fire on safe code)"
  if ! python3 "$ROOT/scripts/verify_ffi_regression_corpus.py"; then
    ec=1
  fi
  sv0_info "sv0 test: SHA-256 KATs (CV-104 — NIST + boundary vectors on native and VM, 200-message differential vs hashlib)"
  if ! python3 "$ROOT/sv0c/test/crypto/sha256/run_kat.py" --differential; then
    ec=1
  fi
  sv0_info "sv0 test: coverage source-unit table (CV-105 — logical paths, digests, concat offsets, scalar columns; native + VM)"
  if ! python3 "$ROOT/sv0c/test/coverage/source/run_source_table.py"; then
    ec=1
  fi
  sv0_info "sv0 test: coverage planner (CV-107 — sources, function entities, function_entry points vs the sv0cov semantic fixtures; native = VM emitter)"
  if ! python3 "$ROOT/sv0c/test/coverage/plan/run_plan.py"; then
    ec=1
  fi
  sv0_info "sv0 test: --coverage modes (CV-106 — off byte-identical on native + VM, map/instrument refused until the planner, usage errors)"
  if ! python3 "$ROOT/scripts/verify_coverage_modes.py"; then
    ec=1
  fi
  sv0_info "sv0 test: fill_explicit DCE-stress (SS-U11/NEW-003 — naive fill elided, sv0_fill_explicit is not)"
  if ! python3 "$ROOT/scripts/verify_fill_explicit_dce.py"; then
    ec=1
  fi
  sv0_info "sv0 test: stage0 C vs lib/golden/stage0 (when present)"
  if ! run_self_host_stage0_golden; then
    ec=1
  fi
  sv0_info "sv0 test: self-host sv0 loop (SML→C→native + emit diff)"
  if ! run_self_host_sv0_loop; then
    ec=1
  fi
  sv0_info "sv0 test: native --project acceptance (PC-3b.6 — cross-module enum+struct → exit 42)"
  if ! run_native_project_acceptance; then
    ec=1
  fi
  sv0_info "sv0 test: Markdown doctests"
  if ! run_doctests; then
    ec=1
  fi
  if [[ "$ec" -ne 0 ]]; then
    sv0_fail "sv0 test: one or more stages failed (exit $ec)"
  fi
  sv0_ok "sv0 test: units + C integration + VM integration + diagnostics corpus behavioral + bootstrap-in-sv0 + vm-parity SML goldens + optional vm-parity tier-2 emit + VM FFI gate + FFI regression corpus + stage0 golden + self-host sv0 loop + native --project acceptance + block-comment guard + sv0doc baseline + task YAML + README sv0c gitlink + vm-parity manifest ⊆ bootstrap + compiler sv0 no-raise + M3 G1 slice path audit + M3 G6 pipeline/link-merge/staging-driver contracts + M3 G7 diagnostics layout + M3 G7 tier-2 policy + M3 G8 native recipe paths + M3 G9 retirement docs + doctests"
}

run_doctests() {
  sv0_require_cmd python3
  python3 "$ROOT/scripts/sv0_doctest.py" --root "$ROOT" \
    "$ROOT/task/sv0-toolchain-milestone-2-prep/doctests.md"
}

# Sets BOOTSTRAP_SV0_RELS (paths relative to sv0c/) for bootstrap-build and stage0 golden checks.
bootstrap_fill_sv0_paths() {
  BOOTSTRAP_SV0_RELS=()
  local list=""
  if [[ -f "$SV0C/lib/bootstrap-sources.list" ]]; then
    list="$SV0C/lib/bootstrap-sources.list"
  fi
  local line
  if [[ -n "$list" ]]; then
    while IFS= read -r line || [[ -n "$line" ]]; do
      [[ "$line" =~ ^[[:space:]]*# ]] && continue
      [[ -z "${line//[[:space:]]/}" ]] && continue
      BOOTSTRAP_SV0_RELS+=("$line")
    done <"$list"
  fi
  if ((${#BOOTSTRAP_SV0_RELS[@]} == 0)); then
    shopt -s nullglob
    local f
    for f in "$SV0C"/lib/*.sv0; do
      BOOTSTRAP_SV0_RELS+=("lib/$(basename "$f")")
    done
    shopt -u nullglob
  fi
}

_self_host_stage0_heap_ready() {
  (cd "$SV0C" && make heap >/dev/null 2>&1)
}

# Emit C via SV0_SELF_HOST_COMPILER contract (M3-S-052 default); write to $2. Requires heap ready.
_self_host_stage0_emit_c_to() {
  local rel="${1:?}"
  local out="${2:?}"
  ensure_sv0_self_host_compiler
  local SHC="${SV0_SELF_HOST_COMPILER:-$ROOT/build/sv0-self-host-compiler}"
  local log abs
  log="$(mktemp)"
  if [[ ! -f "$SV0C/$rel" ]]; then
    rm -f "$log"
    return 1
  fi
  abs="$(_abs_sv0c_rel "$rel")"
  set +e
  "$SHC" "$abs" >"$out" 2>"$log"
  local ec=$?
  set -e
  if [[ "$ec" -ne 0 ]] || grep -q 'Error:\|sv0c error:\|error\[' "$log"; then
    echo "self-host-emit-c: ec=$ec rel=$rel" >&2
    cat "$log" >&2
    rm -f "$log"
    return 1
  fi
  rm -f "$log"
  if ! grep -q '#include' "$out"; then
    echo "self-host: emitted file missing #include: $out" >&2
    return 1
  fi
  return 0
}

run_self_host_stage0_golden() {
  require_sml
  bootstrap_fill_sv0_paths
  local -a rel_paths=("${BOOTSTRAP_SV0_RELS[@]}")
  if ((${#rel_paths[@]} == 0)); then
    sv0_info "self-host stage0 golden: skipped (no bootstrap-in-sv0 sources)"
    return 0
  fi
  local rel stem golden n=0
  for rel in "${rel_paths[@]}"; do
    stem=$(basename "$rel" .sv0)
    golden="$SV0C/lib/golden/stage0/${stem}.c"
    if [[ -f "$golden" ]]; then
      n=$((n + 1))
    fi
  done
  if [[ "$n" -eq 0 ]]; then
    sv0_info "self-host stage0 golden: no lib/golden/stage0/<stem>.c for list entries; skipped"
    return 0
  fi
  if ! _self_host_stage0_heap_ready; then
    sv0_fail "self-host stage0 golden: sv0c make heap failed"
  fi
  # PC-6c: this is an SML byte-guard — the committed lib/golden/stage0/*.c ARE the
  # SML delegate's emit. Even after native became the default SV0_SELF_HOST_COMPILER,
  # pin the emit to the SML delegate so this cross-check keeps verifying the SML
  # reference (native emit diverges byte-for-byte by design and would spuriously
  # fail the diff).
  local ref_shc="$ROOT/build/sv0-self-host-compiler"
  local tmp d
  for rel in "${rel_paths[@]}"; do
    stem=$(basename "$rel" .sv0)
    golden="$SV0C/lib/golden/stage0/${stem}.c"
    if [[ ! -f "$golden" ]]; then
      continue
    fi
    tmp="$(mktemp)"
    if ! ( export SV0_SELF_HOST_COMPILER="$ref_shc"; _self_host_stage0_emit_c_to "$rel" "$tmp" ); then
      rm -f "$tmp"
      sv0_fail "self-host stage0 golden: emit failed for $rel"
    fi
    set +e
    diff -u "$golden" "$tmp"
    d=$?
    set -e
    rm -f "$tmp"
    if [[ "$d" -ne 0 ]]; then
      sv0_fail "self-host stage0 golden: ${stem}.c differs from $golden (refresh golden after intentional C-backend change)"
    fi
  done
  sv0_ok "self-host stage0 golden: $n file(s) match bootstrap C output"
  return 0
}

# PC-3b.6: native --project acceptance — build the native full-compose compiler and
# assert `--project` on the two cross-module fixtures emits C that cc+runs to exit 42
# (source-concat linkProjectDir + PC-2e use-alias fallback). Returns nonzero (does not
# exit) so the caller accumulates into $ec like the other stages. Set
# SV0_SKIP_NATIVE_PROJECT_ACCEPTANCE=1 to skip the (SML->C->cc) native build locally.
run_native_project_acceptance() {
  if [[ -n "${SV0_SKIP_NATIVE_PROJECT_ACCEPTANCE:-}" ]]; then
    sv0_info "native --project acceptance: skipped (SV0_SKIP_NATIVE_PROJECT_ACCEPTANCE set)"
    return 0
  fi
  require_sml
  local log; log="$(mktemp)"
  if ! bash "$ROOT/scripts/pc3b6-native-project-acceptance.sh" >"$log" 2>&1; then
    cat "$log" >&2
    rm -f "$log"
    return 1
  fi
  rm -f "$log"
  sv0_ok "native --project acceptance (PC-3b.6/3c/4b + use-case fixtures): cross-module + struct-pattern + uc_* -> exit 42"
  return 0
}

# Populate SELF_HOST_SV0_LOOP_RELS from sv0c/lib/self-host-sv0-loop.list (paths relative to sv0c/).
self_host_sv0_loop_fill_paths() {
  SELF_HOST_SV0_LOOP_RELS=()
  local list="$SV0C/lib/self-host-sv0-loop.list"
  if [[ ! -f "$list" ]]; then
    return 1
  fi
  local line
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ "$line" =~ ^[[:space:]]*# ]] && continue
    [[ -z "${line//[[:space:]]/}" ]] && continue
    SELF_HOST_SV0_LOOP_RELS+=("${line//[[:space:]]/}")
  done <"$list"
  return 0
}

# ---- content-addressed compile+run result cache ---------------------------------
# Compiling a C program and running it is a pure function of: the C text, the C
# compiler (identity + flags), the runtime sources it links, and the platform.
# _cc_run_cached keys on exactly that (sha256) and replays the previously observed
# (exit status, stdout) instead of re-running cc + the binary. Sound for programs
# whose result depends only on their C (the self-host loop's parity leg already
# requires this: it compares two independent runs byte-for-byte).
#   * disabled by SV0_NO_RUN_CACHE=1 and whenever CI is set (CI runners are fresh
#     and must never replay a stale result);
#   * SV0_RUN_CACHE_DIR overrides the location (default build/run-cache);
#   * entries are written atomically (.rc last), entries older than 14 days pruned.
_sha256() {
  if command -v shasum >/dev/null 2>&1; then shasum -a 256 "$@"; else sha256sum "$@"; fi
}
_run_cache_dir() { printf '%s' "${SV0_RUN_CACHE_DIR:-$ROOT/build/run-cache}"; }
_run_cache_on() { [[ -z "${SV0_NO_RUN_CACHE:-}" && -z "${CI:-}" ]]; }
# Everything besides the C text that determines a compiled program's behaviour.
# Computed once (parent exports it; workers reuse it) -- cc --version + runtime hash.
_run_cache_envkey_init() {
  [[ -n "${SV0_RUN_CACHE_ENVKEY:-}" ]] && return 0
  local cc="${SHL_CC:-${CC:-cc}}" ver rt
  ver="$("$cc" --version 2>&1 | head -1)"
  rt="$(cat "$SV0C"/runtime/*.c "$SV0C"/runtime/*.h | _sha256 | cut -d' ' -f1)"
  SV0_RUN_CACHE_ENVKEY="$(printf '%s\n%s\n%s\n%s\n' "$(uname -sm)" "$cc|$ver" "-std=c99 -O0" "$rt" | _sha256 | cut -d' ' -f1)"
  export SV0_RUN_CACHE_ENVKEY
}
# _cc_run_cached <c-file> <scratch-bin-path> <stdout-file>
# Sets RUN_EXIT to the program's exit status and writes its stdout to <stdout-file>.
# Returns 2 (cc diagnostics on stderr) if the C does not compile; never caches that.
_cc_run_cached() {
  local cfile="$1" bin="$2" out="$3" dir key clog tmp
  RUN_EXIT=0
  dir="$(_run_cache_dir)"
  if _run_cache_on; then
    _run_cache_envkey_init
    key="$( { printf '%s\n' "$SV0_RUN_CACHE_ENVKEY"; cat "$cfile"; } | _sha256 | cut -d' ' -f1)"
    if [[ -f "$dir/$key.rc" && -f "$dir/$key.out" ]]; then
      cp "$dir/$key.out" "$out"
      RUN_EXIT="$(cat "$dir/$key.rc")"
      touch "$dir/$key.rc" 2>/dev/null || true
      return 0
    fi
  fi
  clog="$(mktemp)"
  # No -Werror: sv0c's emitted C may trigger -Wparentheses-equality on Clang; GCC is the CI compiler.
  if ! "${SHL_CC:-${CC:-cc}}" -std=c99 -O0 -I"$SV0C/runtime" -o "$bin" "$cfile" "$SV0C/runtime/sv0_runtime.c" >"$clog" 2>&1; then
    cat "$clog" >&2
    rm -f "$clog"
    return 2
  fi
  rm -f "$clog"
  "$bin" >"$out" 2>/dev/null || RUN_EXIT=$?
  rm -f "$bin"
  if _run_cache_on; then
    mkdir -p "$dir"
    tmp="$dir/.tmp.$$.$RANDOM"
    { cp "$out" "$tmp.out" && printf '%s' "$RUN_EXIT" >"$tmp.rc" \
        && mv "$tmp.out" "$dir/$key.out" && mv "$tmp.rc" "$dir/$key.rc"; } 2>/dev/null \
      || rm -f "$tmp.out" "$tmp.rc"
  fi
  return 0
}
# Age prune (14 days, by last use -- hits touch their entry), then a size cap:
# above SV0_RUN_CACHE_MAX_MB (default 1024) drop the least-recently-used quarter
# of the entries. Each new native-compiler version adds ~50MB of cached emits.
_run_cache_prune() {
  local dir kb max_mb="${SV0_RUN_CACHE_MAX_MB:-1024}" total drop
  dir="$(_run_cache_dir)"
  [[ -d "$dir" ]] || return 0
  find "$dir" -type f -mtime +14 -delete 2>/dev/null || true
  kb="$(du -sk "$dir" 2>/dev/null | cut -f1)"
  if [[ -n "$kb" && "$kb" -gt $((max_mb * 1024)) ]]; then
    total="$(ls "$dir" | wc -l | tr -d ' ')"
    drop=$((total / 4 + 1))
    ls -tr "$dir" | head -n "$drop" | while IFS= read -r f; do rm -f "$dir/$f"; done
  fi
  return 0
}
# `sv0 run-cache-selftest`: hit/miss/invalidation behaviour of _cc_run_cached.
run_cache_selftest() {
  local td n bad=0; td="$(mktemp -d)"
  export SV0_RUN_CACHE_DIR="$td/cache"
  unset SV0_NO_RUN_CACHE CI SV0_RUN_CACHE_ENVKEY 2>/dev/null || true
  local realcc="${CC:-cc}"; SHL_CC="$realcc"
  local a="$td/a.c" b="$td/b.c" p="$td/p.c" bad_c="$td/bad.c"
  printf 'int main(void){return 7;}\n' >"$a"
  printf 'int main(void){return 9;}\n' >"$b"
  printf '#include <stdio.h>\nint main(void){puts("hi");return 0;}\n' >"$p"
  printf 'this is not C\n' >"$bad_c"
  check() { if ! eval "$2"; then echo "run-cache selftest FAIL: $1" >&2; bad=1; fi; }
  entries() { ls "$td/cache"/*.rc 2>/dev/null | wc -l | tr -d ' '; }

  _cc_run_cached "$a" "$td/bin" "$td/out"; check "miss runs the program (exit 7)" '[[ $RUN_EXIT -eq 7 ]]'
  check "miss stores one entry" '[[ $(entries) -eq 1 ]]'
  SHL_CC=/nonexistent-cc                      # a real recompile would now fail
  _cc_run_cached "$a" "$td/bin" "$td/out"; check "hit replays exit 7 without cc" '[[ $? -eq 0 && $RUN_EXIT -eq 7 ]]'
  local rc=0; _cc_run_cached "$b" "$td/bin" "$td/out" 2>/dev/null || rc=$?
  check "different C misses (cc invoked, fails here)" '[[ $rc -eq 2 ]]'
  SHL_CC="$realcc"
  _cc_run_cached "$b" "$td/bin" "$td/out"; check "different C gives its own result (9)" '[[ $RUN_EXIT -eq 9 ]]'
  _cc_run_cached "$p" "$td/bin" "$td/out"; check "miss captures stdout" '[[ "$(cat "$td/out")" == hi ]]'
  SHL_CC=/nonexistent-cc; : >"$td/out"
  _cc_run_cached "$p" "$td/bin" "$td/out"; check "hit replays stdout" '[[ "$(cat "$td/out")" == hi && $RUN_EXIT -eq 0 ]]'
  SV0_RUN_CACHE_ENVKEY=other-environment; export SV0_RUN_CACHE_ENVKEY
  rc=0; _cc_run_cached "$a" "$td/bin" "$td/out" 2>/dev/null || rc=$?
  check "changed environment key invalidates (miss)" '[[ $rc -eq 2 ]]'
  SHL_CC="$realcc"; unset SV0_RUN_CACHE_ENVKEY
  n="$(entries)"
  rc=0; _cc_run_cached "$bad_c" "$td/bin" "$td/out" 2>/dev/null || rc=$?
  check "cc failure returns 2" '[[ $rc -eq 2 ]]'
  check "cc failure is never cached" '[[ $(entries) -eq $n ]]'
  SV0_NO_RUN_CACHE=1; SHL_CC=/nonexistent-cc
  rc=0; _cc_run_cached "$a" "$td/bin" "$td/out" 2>/dev/null || rc=$?
  check "SV0_NO_RUN_CACHE=1 bypasses lookups (cc invoked)" '[[ $rc -eq 2 ]]'
  SHL_CC="$realcc"; n="$(entries)"
  _cc_run_cached "$b" "$td/bin" "$td/out"
  check "SV0_NO_RUN_CACHE=1 stores nothing" '[[ $(entries) -eq $n ]]'
  unset SV0_NO_RUN_CACHE
  CI=true; SHL_CC=/nonexistent-cc; rc=0
  _cc_run_cached "$a" "$td/bin" "$td/out" 2>/dev/null || rc=$?
  check "CI=true bypasses the cache" '[[ $rc -eq 2 ]]'
  unset CI SV0_RUN_CACHE_DIR

  # _artifact_stale: point ROOT/SV0C at a scratch tree (subshell, nothing leaks).
  # Explicit timestamps throughout (bash 3.2's -nt compares whole seconds).
  local sr="$td/tree"; mkdir -p "$sr/sv0c/lib" "$sr/sv0c/runtime" "$sr/sv0c/sml-legacy" "$sr/scripts"
  : >"$sr/sv0c/lib/a.sv0"; : >"$sr/sv0c/sources.cm"; : >"$sr/sv0c/runtime/sv0_runtime.c"
  : >"$sr/sv0c/sml-legacy/x.sml"; : >"$sr/scripts/build.sh"
  printf '#!/bin/sh\n' >"$sr/bin"; chmod +x "$sr/bin"
  local -a inputs=("$sr/sv0c/lib/a.sv0" "$sr/sv0c/sources.cm" "$sr/sv0c/runtime/sv0_runtime.c" \
                   "$sr/sv0c/sml-legacy/x.sml" "$sr/scripts/build.sh")
  reset_times() { touch -t 202001010000 "${inputs[@]}"; touch -t 202101010000 "$sr/bin"; }
  stale() { ( ROOT="$sr"; SV0C="$sr/sv0c"; _artifact_stale "$sr/bin" "$sr/scripts/build.sh" ); }
  reset_times;                                   check "fresh binary is not stale" '! stale'
  touch -t 202201010000 "$sr/sv0c/lib/a.sv0";    check "newer lib/*.sv0 => stale" 'stale'
  reset_times; touch -t 202201010000 "$sr/sv0c/sml-legacy/x.sml"
                                                 check "newer sml-legacy source => stale" 'stale'
  reset_times; touch -t 202201010000 "$sr/scripts/build.sh"
                                                 check "newer build script => stale" 'stale'
  reset_times; touch -t 202201010000 "$sr/bin";  check "rebuilt (newer) binary is fresh" '! stale'
  rm -f "$sr/bin";                               check "missing binary => stale" 'stale'

  rm -rf "$td"
  if ((bad)); then return 1; fi
  echo "run-cache: selftest OK (19 checks: cache + artifact staleness)"
}

# Shared by the parent (run_self_host_sv0_loop) and each parallel per-file
# worker (_self_host_sv0_loop_one, dispatched via `sv0 __self-host-loop-one`)
# -- deliberately recomputed in every process instead of passed down, since
# it's pure env/filesystem-derived logic (no subprocess cost) and every input
# (SV0_SELF_HOST_COMPILER, SV0_SKIP_SELF_HOST_COMPILER_DIFF, CC, the script's
# own path) a worker already inherits or can recompute identically.
_self_host_sv0_loop_setup() {
  SHL_CC="${CC:-cc}"
  SHL_SV0_EMIT="${SV0_SELF_HOST_COMPILER:-}"
  SHL_SV0_EMIT_BOOTSTRAP=0
  if [[ -z "$SHL_SV0_EMIT" && -z "${SV0_SKIP_SELF_HOST_COMPILER_DIFF:-}" && -x "$ROOT/scripts/sv0-self-host-emit-c.sh" ]]; then
    SHL_SV0_EMIT="$ROOT/scripts/sv0-self-host-emit-c.sh"
    SHL_SV0_EMIT_BOOTSTRAP=1
  fi
  SHL_OUTDIR="$ROOT/build/self-host-sv0-loop"
  SHL_BINDIR="$SHL_OUTDIR/bin"
  SHL_EMITDIR="$SHL_OUTDIR/emit"
}

# Process exactly one file of the self-host loop (the original per-file loop
# body, unchanged). Runs as its own process (dispatched by the parent below),
# so `sv0_fail` (exit 1) only ends this one file's worker.
_self_host_sv0_loop_one() {
  local rel="${1:?}"
  _self_host_sv0_loop_setup
  local stem tmp1 tmp2 bin ec
  stem=$(basename "$rel" .sv0)
  if [[ ! -f "$SV0C/$rel" ]]; then
    sv0_fail "self-host-sv0-loop: missing source $SV0C/$rel"
  fi
  tmp1="$SHL_EMITDIR/${stem}.a.c"
  tmp2="$SHL_EMITDIR/${stem}.b.c"
  # Emit cache (default native compiler only): the emit is a pure function of the
  # compiler, the source + its include closure, and the platform (see
  # scripts/emit_cache_key.py). Only emits that already passed the twice-and-cmp
  # determinism check below are ever stored, so a hit replays a verified-deterministic
  # result and skips both native emits (~8s each for the largest files).
  local ekey="" ecache=""
  if _run_cache_on && [[ "${SV0_SELF_HOST_COMPILER:-}" == "$ROOT/build/sv0-megatu-compiler-native" ]]; then
    _run_cache_envkey_init
    ekey="$(python3 "$ROOT/scripts/emit_cache_key.py" key --root "$ROOT" "$(_abs_sv0c_rel "$rel")" 2>/dev/null)" || ekey=""
    [[ -n "$ekey" ]] && ecache="$(_run_cache_dir)/emit-$ekey.c"
  fi
  if [[ -n "$ecache" && -f "$ecache" ]]; then
    cp "$ecache" "$tmp1"
    touch "$ecache" 2>/dev/null || true
  else
    if ! _self_host_stage0_emit_c_to "$rel" "$tmp1"; then
      rm -f "$tmp1" "$tmp2"
      sv0_fail "self-host-sv0-loop: SV0_SELF_HOST_COMPILER emit failed for $rel"
    fi
    if ! _self_host_stage0_emit_c_to "$rel" "$tmp2"; then
      rm -f "$tmp1" "$tmp2"
      sv0_fail "self-host-sv0-loop: second SV0_SELF_HOST_COMPILER emit failed for $rel"
    fi
    if ! cmp -s "$tmp1" "$tmp2"; then
      echo "self-host-sv0-loop: non-deterministic C emit for $rel" >&2
      rm -f "$tmp1" "$tmp2"
      return 1
    fi
    rm -f "$tmp2"
    if [[ -n "$ecache" ]]; then
      mkdir -p "$(dirname "$ecache")"
      cp "$tmp1" "$ecache.tmp.$$" 2>/dev/null && mv "$ecache.tmp.$$" "$ecache" 2>/dev/null \
        || rm -f "$ecache.tmp.$$"
    fi
  fi
  # Behavioral mode with the emitter == SV0_SELF_HOST_COMPILER (the default):
  # the parity leg below would emit, compile and run the exact same C that
  # emits #1/#2 just proved deterministic. Reuse emit #1 there and fold the
  # "native run exits 0" assertion into that single compile+run instead of
  # paying for a second emit + cc + run of identical C.
  local reuse_emit=0
  if [[ "${SV0_SELF_HOST_LOOP_MODE:-bytediff}" == "behavioral" && -n "$SHL_SV0_EMIT" \
        && "$SHL_SV0_EMIT" == "${SV0_SELF_HOST_COMPILER:-}" ]]; then
    reuse_emit=1
  fi
  bin="$SHL_BINDIR/${stem}.out"
  local clog
  if [[ "$reuse_emit" -eq 0 ]]; then
    clog="$(mktemp)"
    # No -Werror: sv0c’s emitted C may trigger -Wparentheses-equality on Clang; GCC is the CI compiler.
    if ! "$SHL_CC" -std=c99 -O0 -I"$SV0C/runtime" -o "$bin" "$tmp1" "$SV0C/runtime/sv0_runtime.c" >"$clog" 2>&1; then
      cat "$clog" >&2
      rm -f "$clog" "$tmp1"
      sv0_fail "self-host-sv0-loop: ${SHL_CC} failed for $rel"
    fi
    rm -f "$clog"
    rm -f "$tmp1"
    ec=0
    "$bin" || ec=$?
    if [[ "$ec" -ne 0 ]]; then
      sv0_fail "self-host-sv0-loop: native run exit $ec for $rel (expected 0)"
    fi
  fi
  if [[ -n "$SHL_SV0_EMIT" ]]; then
    if [[ ! -x "$SHL_SV0_EMIT" ]]; then
      sv0_fail "self-host-sv0-loop: compiler script not executable: $SHL_SV0_EMIT"
    fi
    local tmp_sv0 tmp_err tmp_ref d
    if [[ "$reuse_emit" -eq 1 ]]; then
      tmp_sv0="$tmp1"
    else
      tmp_sv0="$SHL_EMITDIR/${stem}.sv0-built.c"
      tmp_err="$(mktemp)"
      local abs_emit
      abs_emit="$(_abs_sv0c_rel "$rel")"
      if ! "$SHL_SV0_EMIT" "$abs_emit" >"$tmp_sv0" 2>"$tmp_err"; then
        cat "$tmp_err" >&2
        rm -f "$tmp_sv0" "$tmp_err"
        sv0_fail "self-host-sv0-loop: SV0_SELF_HOST_COMPILER emit failed for $rel"
      fi
      rm -f "$tmp_err"
    fi
    tmp_ref="$SHL_EMITDIR/${stem}.ref.c"
    if ! _self_host_emit_c_via_sml_heap_to "$rel" "$tmp_ref"; then
      rm -f "$tmp_sv0" "$tmp_ref"
      sv0_fail "self-host-sv0-loop: SML heap reference emit failed for $rel"
    fi
    if [[ "${SV0_SELF_HOST_LOOP_MODE:-bytediff}" == "behavioral" ]]; then
      # Behavioral-mode (PC-6b): the acceptance is emit+cc+run BEHAVIORAL parity
      # (identical stdout + exit), not byte-identical C. This is the correct
      # surface for a second, INDEPENDENT sv0-built compiler whose C diverges
      # from SML by design (temp naming / decl order / expr structuring — only
      # 40/98 byte-identical, ~109% churn; see doc/l0-closure-roadmap.md B2). Use
      # this when SV0_SELF_HOST_COMPILER is the native mega-TU binary. The default
      # (bytediff) keeps the fast SML-delegate local path exact.
      local bref bsv0 rout sout re2 se2
      bref="$SHL_BINDIR/${stem}.ref.out"
      bsv0="$SHL_BINDIR/${stem}.shc.out"
      rout="$(mktemp)"; sout="$(mktemp)"
      # cc + run of each side goes through the content-addressed result cache:
      # the SML reference C is a pure function of the (frozen) SML compiler and the
      # source, so it almost always hits; the native compiler's C hits whenever its
      # output for this file did not change.
      re2=0; se2=0
      if ! _cc_run_cached "$tmp_ref" "$bref" "$rout"; then
        rm -f "$rout" "$sout" "$tmp_ref" "$tmp_sv0"
        sv0_fail "self-host-sv0-loop: cc of SML reference C failed for $rel"
      fi
      re2="$RUN_EXIT"
      if ! _cc_run_cached "$tmp_sv0" "$bsv0" "$sout"; then
        rm -f "$rout" "$sout" "$tmp_ref" "$tmp_sv0"
        sv0_fail "self-host-sv0-loop: cc of self-host compiler C failed for $rel"
      fi
      se2="$RUN_EXIT"
      rm -f "$tmp_ref" "$tmp_sv0"
      if [[ "$reuse_emit" -eq 1 && "$se2" -ne 0 ]]; then
        rm -f "$rout" "$sout"
        sv0_fail "self-host-sv0-loop: native run exit $se2 for $rel (expected 0)"
      fi
      if [[ "$re2" -ne "$se2" ]] || ! cmp -s "$rout" "$sout"; then
        rm -f "$rout" "$sout"
        sv0_fail "self-host-sv0-loop: behavioral parity differs for $rel (SML exit $re2 vs compiler exit $se2)"
      fi
      rm -f "$rout" "$sout"
    else
      set +e
      diff -u "$tmp_ref" "$tmp_sv0"
      d=$?
      set -e
      rm -f "$tmp_ref" "$tmp_sv0"
      if [[ "$d" -ne 0 ]]; then
        sv0_fail "self-host-sv0-loop: self-host compiler C differs from SML for $rel"
      fi
    fi
  fi
  return 0
}

# Pilot for milestone 3 sv0→sv0 loop: deterministic SV0_SELF_HOST_COMPILER emit, native cc+run, optional diff vs direct SML heap.
# Files are independent (separate stems, separate tmp/bin paths), so they run
# in parallel across up to sv0_jobs() worker processes instead of one at a
# time -- each worker is a fresh `sv0 __self-host-loop-one <rel>` invocation
# (cheap: re-parsing this script is <10ms, far below the cc/sml cost per file).
run_self_host_sv0_loop() {
  require_sml
  ensure_sv0_self_host_compiler
  # PC-6c (native-default promotion): the native mega-TU binary is now the DEFAULT
  # self-host compiler. It emits behaviorally-equivalent C (not byte-identical to
  # SML by design — temp naming / decl order / expr structuring), so the loop also
  # defaults to BEHAVIORAL acceptance (emit+cc+run: identical stdout+exit vs the SML
  # reference). Set SV0_SELF_HOST_COMPILER to pin a specific compiler (e.g. the SML
  # delegate for a byte-diff run); the SML byte-guards — the stage0 golden gate and
  # this loop's reference leg — stay on SML regardless.
  if [[ -z "${SV0_SELF_HOST_COMPILER:-}" ]]; then
    ensure_sv0_megatu_native
    export SV0_SELF_HOST_COMPILER="$ROOT/build/sv0-megatu-compiler-native"
    export SV0_SELF_HOST_LOOP_MODE="${SV0_SELF_HOST_LOOP_MODE:-behavioral}"
  fi
  if ! command -v "${CC:-cc}" >/dev/null 2>&1; then
    sv0_fail "self-host-sv0-loop: C compiler not found (install cc or set CC)"
  fi
  if ! _self_host_stage0_heap_ready; then
    sv0_fail "self-host-sv0-loop: sv0c make heap failed"
  fi
  if ! self_host_sv0_loop_fill_paths; then
    sv0_fail "self-host-sv0-loop: missing $SV0C/lib/self-host-sv0-loop.list"
  fi
  if ((${#SELF_HOST_SV0_LOOP_RELS[@]} == 0)); then
    sv0_warn "self-host-sv0-loop: empty pilot list; skipped"
    return 0
  fi
  _self_host_sv0_loop_setup
  mkdir -p "$SHL_BINDIR" "$SHL_EMITDIR"
  if _run_cache_on; then
    _run_cache_prune
    _run_cache_envkey_init
  fi

  local resultdir
  resultdir="$(mktemp -d)"
  local njobs
  njobs="$(sv0_jobs)"
  printf '%s\n' "${SELF_HOST_SV0_LOOP_RELS[@]}" \
    | SV0_LOOP_SCRIPT="$ROOT/scripts/sv0" SV0_LOOP_RESULTDIR="$resultdir" \
      xargs -P "$njobs" -I{} bash -c '
        rel="$1"
        log="$SV0_LOOP_RESULTDIR/$(printf "%s" "$rel" | tr "/" "_").log"
        if ! "$SV0_LOOP_SCRIPT" __self-host-loop-one "$rel" >"$log" 2>&1; then
          printf "%s\n" "$rel" >> "$SV0_LOOP_RESULTDIR/FAILED"
        fi
      ' _ {}

  if [[ -s "$resultdir/FAILED" ]]; then
    local frel flog
    while IFS= read -r frel || [[ -n "$frel" ]]; do
      [[ -z "$frel" ]] && continue
      flog="$resultdir/$(printf "%s" "$frel" | tr "/" "_").log"
      echo "self-host-sv0-loop: FAILED $frel" >&2
      [[ -f "$flog" ]] && tail -40 "$flog" >&2
    done <"$resultdir/FAILED"
    rm -rf "$resultdir"
    sv0_fail "self-host-sv0-loop: one or more file(s) failed (see above)"
  fi
  rm -rf "$resultdir"

  if [[ -n "$SHL_SV0_EMIT" ]]; then
    if [[ "$SHL_SV0_EMIT_BOOTSTRAP" -eq 1 ]]; then
      sv0_ok "self-host-sv0-loop: ${#SELF_HOST_SV0_LOOP_RELS[@]} file(s); emit+cc+run OK; bootstrap wrapper matched SML (set SV0_SELF_HOST_COMPILER to native sv0 compiler when ready)"
    elif [[ "${SV0_SELF_HOST_LOOP_MODE:-bytediff}" == "behavioral" ]]; then
      sv0_ok "self-host-sv0-loop: ${#SELF_HOST_SV0_LOOP_RELS[@]} file(s); emit+cc+run OK; SV0_SELF_HOST_COMPILER BEHAVIORAL parity with SML (identical stdout+exit; C differs by design)"
    else
      sv0_ok "self-host-sv0-loop: ${#SELF_HOST_SV0_LOOP_RELS[@]} file(s); emit+cc+run OK; SV0_SELF_HOST_COMPILER output matched SML"
    fi
  else
    sv0_ok "self-host-sv0-loop: ${#SELF_HOST_SV0_LOOP_RELS[@]} file(s); deterministic SML emit and cc+run OK (SV0_SKIP_SELF_HOST_COMPILER_DIFF=1 skips emit diff)"
  fi
  return 0
}

run_bootstrap_build() {
  require_sml
  mkdir -p "$SV0C/build/vm"
  local rel stem sv0b
  bootstrap_fill_sv0_paths
  local -a rel_paths=("${BOOTSTRAP_SV0_RELS[@]}")
  if ((${#rel_paths[@]} == 0)); then
    sv0_warn "bootstrap-build: no lib/bootstrap-sources.list and no top-level lib/*.sv0"
    sv0_ok "bootstrap-build: skipped (no sources)"
    return 0
  fi
  local -a stems=()
  for rel in "${rel_paths[@]}"; do
    if [[ ! -f "$SV0C/$rel" ]]; then
      echo "bootstrap-build: missing file $SV0C/$rel" >&2
      return 1
    fi
    stems+=("$(basename "$rel" .sv0)")
  done

  # Batch every listed .sv0 through ONE sml process (one CM.make + N in-
  # process Main.compileFileVm calls) instead of a fresh `sml` cold start
  # per file — the same batching verify_behavior_corpus_vm.py already uses
  # for its compile phase (Main.compileFileVm is --target=vm's underlying
  # emitter). Cuts ~N `sml` process spawns down to 1.
  local tab=$'\t'
  local paths_sml="" rel_esc
  for rel in "${rel_paths[@]}"; do
    rel_esc="${rel//\\/\\\\}"
    rel_esc="${rel_esc//\"/\\\"}"
    paths_sml+="${paths_sml:+, }\"$rel_esc\""
  done
  local compile_script clog
  compile_script=$(cat <<SML
CM.make "sources.cm";
fun doCompile p = (Main.compileFileVm p; print ("BRES\t" ^ p ^ "\tOK\n"))
  handle _ => print ("BRES\t" ^ p ^ "\tERR\n");
val () = List.app doCompile [${paths_sml}];
OS.Process.exit OS.Process.success;
SML
)
  clog="$(mktemp)"
  if ! (cd "$SV0C" && printf '%s\n' "$compile_script" | sml >"$clog" 2>&1); then
    echo "bootstrap-build: sml compile pass failed" >&2
    tail -60 "$clog" >&2
    rm -f "$clog"
    return 1
  fi
  local failed=0
  for rel in "${rel_paths[@]}"; do
    if ! grep -qF "BRES${tab}${rel}${tab}OK" "$clog" \
       || grep -qF "BRES${tab}${rel}${tab}ERR" "$clog"; then
      echo "bootstrap-build: compile failed for $rel" >&2
      failed=1
    fi
  done
  if grep -q 'Error:\|sv0c error:\|error\[' "$clog"; then
    echo "bootstrap-build: compile log reported error(s)" >&2
    failed=1
  fi
  if ((failed)); then
    echo "bootstrap-build: compile log (tail):" >&2
    tail -100 "$clog" >&2
    rm -f "$clog"
    return 1
  fi
  rm -f "$clog"
  for rel in "${rel_paths[@]}"; do
    stem=$(basename "$rel" .sv0)
    sv0b="$SV0C/build/vm/${stem}.sv0b"
    if [[ ! -f "$sv0b" ]]; then
      echo "bootstrap-build: missing $sv0b (for $rel) after compile" >&2
      return 1
    fi
  done

  # Run every emitted .sv0b on sv0vm in ONE sml process (same batching for
  # the VM-run leg).
  local i cases_sml=""
  for i in "${!rel_paths[@]}"; do
    cases_sml+="${cases_sml:+, }(\"${stems[$i]}\",\"$SV0C/build/vm/${stems[$i]}.sv0b\")"
  done
  local run_script rlog
  run_script=$(cat <<SML
use "src/main.sml";
fun runOne (stem, path) =
  (let val e = Interpreter.runFile path
   in print ("VMRES\t" ^ stem ^ "\t" ^ Int.toString e ^ "\n") end)
  handle _ => print ("VMRES\t" ^ stem ^ "\tERR\n");
val () = List.app runOne [${cases_sml}];
OS.Process.exit OS.Process.success;
SML
)
  rlog="$(mktemp)"
  (cd "$SV0VM" && printf '%s\n' "$run_script" | sml >"$rlog" 2>&1) || true
  local bad=0 line status
  for i in "${!stems[@]}"; do
    line="$(grep -F "VMRES${tab}${stems[$i]}${tab}" "$rlog" | tail -1)"
    status="${line##*"${tab}"}"
    if [[ "$status" != "0" ]]; then
      echo "bootstrap-build: FAIL ${rel_paths[$i]} (vm_exit:${status:-none})" >&2
      bad=1
    fi
  done
  if ((bad)); then
    echo "bootstrap-build: VM run log (tail):" >&2
    tail -60 "$rlog" >&2
    rm -f "$rlog"
    return 1
  fi
  rm -f "$rlog"
  sv0_ok "bootstrap-build: all listed (or top-level lib/*.sv0) programs passed on VM"
  return 0
}

# Compare build/vm/<stem>.sv0b (from bootstrap-build) to test/vm-parity/golden/sml/<stem>.sv0b.
run_vm_parity_sml_goldens() {
  local manifest="$SV0C/test/vm-parity/manifest.txt"
  if [[ ! -f "$manifest" ]]; then
    sv0_ok "vm-parity SML goldens: skipped (no manifest)"
    return 0
  fi
  local line rel stem golden built n
  n=0
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -z "${line//[[:space:]]/}" ]] && continue
    [[ "$line" =~ ^[[:space:]]*# ]] && continue
    rel="${line//[[:space:]]/}"
    stem=$(basename "$rel" .sv0)
    golden="$SV0C/test/vm-parity/golden/sml/${stem}.sv0b"
    built="$SV0C/build/vm/${stem}.sv0b"
    if [[ ! -f "$golden" ]]; then
      sv0_fail "vm-parity: missing golden $golden — run ./scripts/capture_vm_parity_goldens.sh from repo root"
      return 1
    fi
    if [[ ! -f "$built" ]]; then
      sv0_fail "vm-parity: missing $built (expected after bootstrap-build for $rel)"
      return 1
    fi
    if ! cmp -s "$built" "$golden"; then
      echo "vm-parity: bytecode mismatch for ${stem} ($rel)" >&2
      echo "  fresh:  $built" >&2
      echo "  golden: $golden" >&2
      echo "  refresh: ./scripts/capture_vm_parity_goldens.sh" >&2
      return 1
    fi
    n=$((n + 1))
  done <"$manifest"
  sv0_ok "vm-parity SML goldens: $n file(s) match bootstrap VM emit"
  return 0
}

# M3-S-045: optional second leg — re-emit VM bytecode for tier2-manifest paths using
# SV0_VM_BYTECODE_EMITTER (native sv0 compiler or scripts/sv0-vm-tier2-emit-bootstrap.sh),
# then cmp to golden/sml/<stem>.sv0b. Skipped when env unset (default CI).
run_vm_parity_tier2_emit_compare() {
  local emit="${SV0_VM_BYTECODE_EMITTER:-}"
  if [[ -z "$emit" ]]; then
    sv0_info "vm-parity tier-2 emit compare: skipped (SV0_VM_BYTECODE_EMITTER unset)"
    return 0
  fi
  if [[ "${emit:0:1}" != "/" && -x "$ROOT/$emit" ]]; then
    emit="$ROOT/$emit"
  elif [[ "${emit:0:1}" != "/" && -f "$ROOT/$emit" ]]; then
    emit="$ROOT/$emit"
  fi
  if [[ ! -f "$emit" ]]; then
    sv0_fail "vm-parity tier-2: SV0_VM_BYTECODE_EMITTER not found: $emit"
    return 1
  fi
  if [[ ! -x "$emit" ]]; then
    sv0_fail "vm-parity tier-2: SV0_VM_BYTECODE_EMITTER not executable: $emit"
    return 1
  fi
  require_sml
  local manifest="$SV0C/test/vm-parity/tier2-manifest.txt"
  if [[ ! -f "$manifest" ]]; then
    sv0_ok "vm-parity tier-2 emit compare: skipped (no tier2-manifest.txt)"
    return 0
  fi
  local line rel stem golden built n
  n=0
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -z "${line//[[:space:]]/}" ]] && continue
    [[ "$line" =~ ^[[:space:]]*# ]] && continue
    rel="${line//[[:space:]]/}"
    stem=$(basename "$rel" .sv0)
    golden="$SV0C/test/vm-parity/golden/sml/${stem}.sv0b"
    built="$SV0C/build/vm/${stem}.sv0b"
    if [[ ! -f "$golden" ]]; then
      sv0_fail "vm-parity tier-2: missing golden $golden"
      return 1
    fi
    sv0_info "vm-parity tier-2: emit $rel via $emit"
    if ! ( export SV0TOOLCHAIN_ROOT="$ROOT" SV0C_ROOT="$SV0C"; "$emit" "$rel" ); then
      sv0_fail "vm-parity tier-2: emitter failed for $rel"
      return 1
    fi
    if [[ ! -f "$built" ]]; then
      sv0_fail "vm-parity tier-2: missing $built after emit ($rel)"
      return 1
    fi
    if ! cmp -s "$built" "$golden"; then
      echo "vm-parity tier-2: bytecode mismatch for ${stem} ($rel)" >&2
      echo "  fresh:  $built" >&2
      echo "  golden: $golden" >&2
      return 1
    fi
    n=$((n + 1))
  done <"$manifest"
  sv0_ok "vm-parity tier-2 emit compare: $n file(s) matched golden/sml ($emit)"
  return 0
}

run_emit_c() {
  local rel="${1:-}"
  if [[ -z "$rel" ]]; then
    echo "usage: sv0 emit-c <path-relative-to-sv0c/>" >&2
    exit 1
  fi
  require_sml
  if [[ ! -f "$SV0C/$rel" ]]; then
    sv0_fail "emit-c: not found: $SV0C/$rel"
  fi
  if ! (cd "$SV0C" && make heap >/dev/null 2>&1); then
    sv0_fail "emit-c: sv0c make heap failed"
  fi
  ensure_sv0_self_host_compiler
  local SHC="${SV0_SELF_HOST_COMPILER:-$ROOT/build/sv0-self-host-compiler}"
  local abs
  abs="$(_abs_sv0c_rel "$rel")"
  "$SHC" "$abs"
}

run_compile_run() {
  local rel="${1:-}"
  if [[ -z "$rel" ]]; then
    echo "usage: sv0 compile-run <path-relative-to-sv0c/>" >&2
    exit 1
  fi
  if [[ ! -f "$SV0C/$rel" ]]; then
    sv0_fail "compile-run: not found: $SV0C/$rel"
  fi
  local stem
  stem="$(basename "$rel" .sv0)"
  local tmpdir
  tmpdir="$(mktemp -d)"
  local c_file="$tmpdir/${stem}.c"
  local bin_file="$tmpdir/${stem}"
  local _cc="${CC:-cc}"

  if ! run_emit_c "$rel" > "$c_file" 2>/dev/null; then
    rm -rf "$tmpdir"
    sv0_fail "compile-run: emit-c failed for $rel"
  fi

  local clog="$tmpdir/cc.log"
  if ! "$_cc" -std=c99 -O0 -I"$SV0C/runtime" -o "$bin_file" "$c_file" "$SV0C/runtime/sv0_runtime.c" >"$clog" 2>&1; then
    echo "compile-run: cc failed for $rel:" >&2
    cat "$clog" >&2
    rm -rf "$tmpdir"
    exit 1
  fi

  local ec=0
  "$bin_file" || ec=$?
  rm -rf "$tmpdir"
  if [[ "$ec" -ne 0 ]]; then
    sv0_fail "compile-run: $rel exited $ec (expected 0)"
  fi
  sv0_ok "compile-run: $rel"
}

run_self_host_capture_stage0() {
  local rel="${1:-}"
  if [[ -z "$rel" ]]; then
    echo "usage: sv0 self-host-capture-stage0 <path-relative-to-sv0c/>" >&2
    exit 1
  fi
  local stem
  stem=$(basename "$rel" .sv0)
  local outdir="$ROOT/build/self-host-compare/stage0"
  mkdir -p "$outdir"
  local out="$outdir/${stem}.c"
  require_sml
  if [[ ! -f "$SV0C/$rel" ]]; then
    sv0_fail "self-host-capture-stage0: not found: $SV0C/$rel"
  fi
  if ! _self_host_stage0_heap_ready; then
    sv0_fail "self-host-capture-stage0: sv0c make heap failed"
  fi
  if ! _self_host_stage0_emit_c_to "$rel" "$out"; then
    sv0_fail "self-host-capture-stage0: compile failed for $rel"
  fi
  sv0_ok "self-host-capture-stage0: wrote $out"
}

run_self_host_compare() {
  local stem="${1:-}"
  if [[ -z "$stem" ]]; then
    echo "usage: sv0 self-host-compare <stem>   (e.g. span_core for span_core.c)" >&2
    exit 1
  fi
  local s0="$ROOT/build/self-host-compare/stage0/${stem}.c"
  local s1="$ROOT/build/self-host-compare/stage1/${stem}.c"
  if [[ ! -f "$s0" ]]; then
    sv0_fail "self-host-compare: missing stage0 file $s0 (run self-host-capture-stage0 first)"
  fi
  if [[ ! -f "$s1" ]]; then
    sv0_info "self-host-compare: stage1 missing $s1 — nothing to diff yet"
    return 0
  fi
  set +e
  diff -u "$s0" "$s1"
  local d=$?
  set -e
  if [[ "$d" -eq 0 ]]; then
    sv0_ok "self-host-compare: $stem stage0 and stage1 C are identical"
  else
    sv0_fail "self-host-compare: $stem differs between stage0 and stage1"
  fi
}

run_test_mcp() {
  sv0_require_dir "$SV0_MCP"
  if command -v uv >/dev/null 2>&1; then
    (cd "$SV0_MCP" && uv sync --all-extras)
    (cd "$SV0_MCP" && uv run pytest tests/ -q)
    sv0_ok "sv0-mcp: pytest"
  else
    sv0_info "uv not in PATH; skipped sv0-mcp tests (install uv or run from sv0-mcp/)"
  fi
}

