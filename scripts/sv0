#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
SV0C="$ROOT/sv0c"
SV0VM="$ROOT/sv0vm"
SV0DOC="$ROOT/sv0doc"
SV0_MCP="$ROOT/sv0-mcp"

# SML/NJ uses the C stack for recursive AST walks.  The default macOS
# stack (≈8 MB) can overflow on deeply nested expressions in large .sv0
# files.  Raise the soft limit to the hard limit so the bootstrap
# compiler has maximum headroom.
ulimit -s "$(ulimit -Hs)" 2>/dev/null || true

# shellcheck disable=SC1091
source "$ROOT/lib/shell/common.sh"

usage() {
  cat >&2 <<EOF
usage: sv0 <command> [args]

  Design (M3 G6): intended compiler pipeline is tokenize → parse → resolve →
    check → analyze → strip → lower → emit (C and/or VM); see sv0c/lib/main.sv0
    (PHASE_* and DRIVER_FULL_PIPELINE_LEN).

  Bootstrap compiler CLI (sv0c — see sv0c/doc/cli-parity.md; mirrors sv0c/sml-legacy/main.sml):
    <file.sv0>                    compile to C on stdout
    --target=vm <file.sv0>        emit build/vm/<stem>.sv0b (VM bytecode)
    --target=vm --project <dir>   link *.sv0 under dir; VM emit uses project_vm_entry_stem
    --project <dir> --target=vm   same VM project mode (flag order accepted by Main.main)
    --project <dir>               link project directory (C stdout mode in SML driver)

  check              compile sv0c (CM) and sv0vm (use) — fast smoke compile
  build              alias for check
  test               sv0c units; .sv0 block-comment guard; sv0doc baseline; task/*.Rmd YAML lint;
                       README sv0c gitlink vs bootstrap table; sv0vm bytecode tests; C + VM integration;
                       bootstrap .sv0 on VM; VM parity vs test/vm-parity/golden/sml; stage0 golden C vs SML
                       emit (when lib/golden/stage0/<stem>.c exists); self-host sv0 loop (SML→C→native + emit diff);
                       Markdown doctests — see task/sv0-toolchain-milestone-2-prep.Rmd for order
  test-guards        Python only: block-comment nesting, sv0doc baseline, task/*.Rmd YAML, README sv0c SHA, vm-parity manifest ⊆ bootstrap list,
                       task/milestone-orientation.json (primary_tasks exist + bidirectional sync with workspace milestone table),
                       compiler .sv0 no-raise guard (sv0c/lib|lexer|parser — M3-S-014); NEX-001 native-exe
                       requirement traceability (checklist ⊇ active-release catalog)
                       (no SML — use after editing task/*.Rmd, sv0doc, README bootstrap table, or .sv0)
  test-mcp           sv0-mcp pytest via uv (skips if uv not installed)
  doc                generate build/sv0-toolchain-doc/index.md; verify sv0doc + sv0-mcp paths
  doctest            run Markdown sv0 doctests only (see task/sv0-toolchain-milestone-2-prep/doctests.md)
  fmt                format .sv0 sources (whitespace) + shell fmt (see fmt-shell)
  fmt-shell          bash -n on shell scripts; shfmt -w if shfmt is in PATH
  bootstrap-build    VM-compile programs listed in sv0c/lib/bootstrap-sources.list (fallback: lib/*.sv0)
  emit-c <rel>       print C for one .sv0 (path relative to sv0c/; heap + SV0_SELF_HOST_COMPILER — default build/sv0-self-host-compiler)
  compile-run <rel>  emit-c + cc + run for one .sv0 (exit 0 = pass; non-zero = fail)
  verify [--json] <file>  static contract verification (M4): parse -> VCgen -> z3, report
                       per-contract [verified]/[runtime] + reason (sv0doc contracts §3.2);
                       --json emits a machine-readable object (needs z3; degrades to runtime without)
  emit-verified <file>  verified contract-mode (M4): verify, then emit C with the PROVEN
                       ensures' runtime checks stripped (unproven + requires kept); C to stdout
  compile [--contract-mode=runtime|verified|disabled] <file>  emit C honoring the contract
                       mode; precedence flag > sv0.toml [build] contract-mode (beside <file>) > runtime
  self-host-capture-stage0 <rel>  write C to build/self-host-compare/stage0/<stem>.c (stage-0 snapshot)
  self-host-compare <stem>  diff stage0 vs stage1 C for <stem> when both files exist
  self-host-check-golden  diff bootstrap C vs lib/golden/stage0/<stem>.c (same rules as sv0 test)
  self-host-sv0-loop     sv0→sv0 loop: deterministic emit + cc+run on lib/self-host-sv0-loop.list.
                           DEFAULT (PC-6c promotion): the native mega-TU compiler (build/sv0-megatu-compiler-native),
                           accepted BEHAVIORALLY vs SML (identical stdout+exit; C differs by design). Export
                           SV0_SELF_HOST_COMPILER to pin a compiler — e.g. build/sv0-self-host-compiler for the
                           SML delegate byte-diff (SV0_SELF_HOST_LOOP_MODE=bytediff, the pre-promotion path).
                           SV0_SKIP_SELF_HOST_COMPILER_DIFF=1 skips the reference leg; see sv0c/doc/self-host-sv0-loop.md
  build-self-host-compiler  write build/sv0-self-host-compiler (wrapper for SV0_SELF_HOST_COMPILER — M3-S-047);
                           see sv0c/doc/native-self-host-compiler-recipe.md
  self-host-native-parity  native driver (build/sv0-driver-native) vs SML BEHAVIORAL parity on
                           self-host-sv0-loop.list: emit+cc+run both, require identical stdout+exit
                           (98/98). The principled native third-leg check — see l0-closure-roadmap.md
  assemble-megatu [--check]  native-compose (A): assemble sv0c/lib/megaTU-modules.list into one
                           build/megaTU.sv0 (strip test mains/tests, auto-namespace collisions);
                           --check also SML->C->cc compiles it. Full 18-module pipeline compiles
                           (A1) — see sv0c/doc/archive/native-compose-tradeoffs.md
  sml-retirement-preflight   print blast-radius scan for `sml/` path refs before M3-S-051 (no edits)
  integration-vm     VM pipeline integration tests (task script)
  vm-compile <rel>   sv0c --target=vm; path relative to sv0c/
  vm-project-compile <dir>  sv0c --target=vm --project <dir>; path relative to sv0c/ (writes build/vm/main.sv0b when main.sv0 exists)
  vm-run <file.sv0b> run bytecode via sv0vm/scripts/run_sv0b.sml
  repl               interactive line-at-a-time eval via VM (i32 expr or println(\"...\"))
  ci                 check + full ./scripts/sv0 test (no sv0-mcp; same as \`make ci\`)
  ci-all             after ci, run test-mcp when uv is available (full toolchain smoke)
  milestone-orient [list | show <id> | <id>]  LLM/human orientation from task/milestone-orientation.json
                       (ids: M0, M1, M2, M2-prep, M3, …, cross-cutting, mcp-0, roadmap; <id> alone means show)
  progress-dashboard [port]  local browser UI for milestone + sv0-track digest (default port 8765; 127.0.0.1 only; SV0_PROGRESS_DASHBOARD_REFRESH sec TTL)
  mcp-light-stack [up|down]  docker compose in sv0-mcp: Neo4j + progress-dashboard (default up). Uses SV0_MCP_TOOLCHAIN_ROOT (default meta-repo root) and SV0_MCP_PROGRESS_DASHBOARD_REFRESH (default 300) for a light rescan interval.

EOF
}

require_sml() {
  sv0_require_cmd sml
}

sml_log_check() {
  local label="$1"
  local log="$2"
  if grep -q 'Error:' "$log"; then
    tail -50 "$log"
    rm -f "$log"
    sv0_fail "$label: SML compile errors"
  fi
  rm -f "$log"
}

ensure_sv0_self_host_compiler() {
  local out="$ROOT/build/sv0-self-host-compiler"
  if [[ ! -x "$out" ]]; then
    bash "$ROOT/scripts/build-sv0-self-host-compiler.sh"
  fi
  if [[ ! -x "$out" ]]; then
    sv0_fail "ensure_sv0_self_host_compiler: missing executable $out"
  fi
  # lib/driver.sv0's test mode calls read_file("/tmp/.sv0_drv_path") unconditionally,
  # and read_file panics when fopen fails. build-sv0-self-host-compiler.sh creates the
  # file empty, but it is skipped once the wrapper exists (and /tmp gets reaped), so
  # guarantee the control file here for every self-host path.
  [[ -f /tmp/.sv0_drv_path ]] || printf '' > /tmp/.sv0_drv_path
}

# PC-6c (native-default promotion): materialize the native mega-TU compiler
# (build/sv0-megatu-compiler-native), the sv0-built binary that is now the DEFAULT
# SV0_SELF_HOST_COMPILER. Its wrapper honors the same contract (argv[1] = .sv0 path,
# emitted C to stdout). Built from lib/*.sv0 via the full compose; rebuilt only when
# absent (the native --project acceptance rebuilds it later in the same gate).
ensure_sv0_megatu_native() {
  local out="$ROOT/build/sv0-megatu-compiler-native"
  if [[ ! -x "$out" ]]; then
    bash "$ROOT/scripts/build-sv0-megatu-native.sh" >&2
  fi
  if [[ ! -x "$out" ]]; then
    sv0_fail "ensure_sv0_megatu_native: missing executable $out (build-sv0-megatu-native.sh failed)"
  fi
  [[ -f /tmp/.sv0_drv_path ]] || printf '' > /tmp/.sv0_drv_path
}

# M4-S-020: materialize the native contract-VERIFY binary (build/sv0-megatu-verify),
# which tokenizes + parses a .sv0 and emits SMT-LIB2 obligation records (see
# build-sv0-megatu-verify-native.sh). Rebuilt only when absent.
ensure_sv0_megatu_verify() {
  local out="$ROOT/build/sv0-megatu-verify"
  if [[ ! -x "$out" ]]; then
    bash "$ROOT/scripts/build-sv0-megatu-verify-native.sh" >&2
  fi
  if [[ ! -x "$out" ]]; then
    sv0_fail "ensure_sv0_megatu_verify: missing executable $out (build-sv0-megatu-verify-native.sh failed)"
  fi
  [[ -f /tmp/.sv0_verify_path ]] || printf '' > /tmp/.sv0_verify_path
}

# M4-S-020/021: `sv0 verify <file>` — driver-orchestrated static contract
# verification with a per-contract report (sv0doc/contracts/semantics.md §3.2).
# The native verify binary emits one record per contract clause
# (`VC<TAB>line<TAB>kind<TAB>clause<TAB>payload`; payload = smt2 query | RESIDUAL |
# PRECOND); this driver runs each ensures query through scripts/sv0-z3.sh and
# prints `<file>:<line>  <clause>  [verified|runtime]  -- <reason>`. z3 `unsat` ⇒
# proven; anything else (sat/unknown/absent/unsupported) ⇒ keep the runtime check
# (soundness: only a solid unsat strips an obligation). requires clauses are
# preconditions (assumed locally, discharged at call sites under modular
# verification); loop invariants are not yet handled — both stay [runtime]. Exit 0
# always (a report, not a gate) unless the file can't be parsed.
# Minimal JSON string escaper (backslash + double-quote + control chars we might
# see in a clause/reason). Clauses are whitespace-collapsed already.
_json_esc() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  s="${s//	/\\t}"
  printf '%s' "$s"
}

# M4-S-022: `sv0 verify [--json] <file>`. With --json, emit one machine-readable
# object for tooling/CI (the verify corpus, M4-S-040/042) instead of the §3.2
# table. $2 = 1 selects JSON.
run_verify() {
  local file="${1:?}"
  local json="${2:-0}"
  [[ -f "$file" ]] || sv0_fail "verify: no such file: $file"
  ensure_sv0_megatu_verify
  local abs
  abs="$(cd "$(dirname "$file")" && pwd)/$(basename "$file")"
  printf '' > /tmp/.sv0_drv_path
  local records
  if ! records="$("$ROOT/build/sv0-megatu-verify" "$abs")"; then
    sv0_fail "verify: parse/emit failed for $file (does it compile?)"
  fi
  if [[ -z "$records" ]]; then
    if [[ "$json" == "1" ]]; then
      printf '{"file":"%s","contracts":[],"summary":{"verified":0,"runtime":0}}\n' "$(_json_esc "$file")"
    else
      echo "verify: $(basename "$file") — no contracts to verify"
    fi
    return 0
  fi
  local have_z3=1
  command -v z3 >/dev/null 2>&1 || have_z3=0
  if [[ "$have_z3" -eq 0 && "$json" != "1" ]]; then
    sv0_info "verify: z3 not on PATH — ensures obligations reported [runtime] (install z3 to prove)"
  fi
  local -a o_line=() o_kind=() o_clause=() o_status=() o_reason=()
  local n_verified=0 n_runtime=0 maxw=0 maxp=0
  local tmpq
  tmpq="$(mktemp)"
  local tag line kind clause payload status reason verdict
  while IFS=$'\t' read -r tag line kind clause payload; do
    [[ "$tag" == "VC" ]] || continue
    status="runtime"
    reason="not checked"
    if [[ "$payload" == "PRECOND" ]]; then
      reason="input precondition (assumed locally)"
    elif [[ "$payload" == "RESIDUAL" ]]; then
      if [[ "$kind" == "loop_invariant" ]]; then
        reason="loop invariants not yet supported"
      else
        reason="outside supported fragment"
      fi
    elif [[ "$have_z3" -eq 0 ]]; then
      reason="no solver (z3 not found)"
    else
      printf '%s\n' "$payload" > "$tmpq"
      verdict="$(bash "$ROOT/scripts/sv0-z3.sh" "$tmpq" 2>/dev/null | head -1)"
      case "$verdict" in
        unsat) status="verified"; reason="proven" ;;
        sat) reason="not proven (counterexample)" ;;
        *) reason="not proven (solver: ${verdict:-timeout})" ;;
      esac
    fi
    if [[ "$status" == "verified" ]]; then
      n_verified=$((n_verified + 1))
    else
      n_runtime=$((n_runtime + 1))
    fi
    o_line+=("$line")
    o_kind+=("$kind")
    o_clause+=("$clause")
    o_status+=("$status")
    o_reason+=("$reason")
    ((${#clause} > maxw)) && maxw=${#clause}
    local plen=$((${#file} + 1 + ${#line}))
    ((plen > maxp)) && maxp=$plen
  done <<< "$records"
  rm -f "$tmpq"
  local i
  if [[ "$json" == "1" ]]; then
    local body="" sep=""
    for i in "${!o_clause[@]}"; do
      body+="${sep}{\"line\":${o_line[$i]},\"kind\":\"$(_json_esc "${o_kind[$i]}")\",\"clause\":\"$(_json_esc "${o_clause[$i]}")\",\"status\":\"${o_status[$i]}\",\"reason\":\"$(_json_esc "${o_reason[$i]}")\"}"
      sep=","
    done
    printf '{"file":"%s","contracts":[%s],"summary":{"verified":%d,"runtime":%d}}\n' \
      "$(_json_esc "$file")" "$body" "$n_verified" "$n_runtime"
    return 0
  fi
  local sb prefix
  for i in "${!o_clause[@]}"; do
    sb="[${o_status[$i]}]"
    prefix="$file:${o_line[$i]}"
    printf '%-*s  %-*s  %-10s -- %s\n' \
      "$maxp" "$prefix" "$maxw" "${o_clause[$i]}" "$sb" "${o_reason[$i]}"
  done
  printf 'verify: %s — %d verified, %d runtime\n' "$(basename "$file")" "$n_verified" "$n_runtime"
  return 0
}

# M4-S-023/024: `sv0 emit-verified <file>` — verified contract-mode. Two passes:
# (1) `sv0 verify` proves what it can; (2) the native compiler recompiles with the
# proven `ensures` runtime checks STRIPPED (unproven checks + all `requires` stay).
# Emits the resulting C to stdout. Degrades to a normal compile (nothing stripped)
# when z3 is absent — soundness: only a solid unsat removes a check.
run_emit_verified() {
  local file="${1:?}"
  [[ -f "$file" ]] || sv0_fail "emit-verified: no such file: $file"
  ensure_sv0_megatu_native
  ensure_sv0_megatu_verify
  local abs
  abs="$(cd "$(dirname "$file")" && pwd)/$(basename "$file")"
  local proof
  proof="$(mktemp)"
  # pass 1: collect the source lines of proven ensures (empty if z3 absent)
  if command -v z3 >/dev/null 2>&1; then
    printf '' > /tmp/.sv0_drv_path
    "$ROOT/build/sv0-megatu-verify" "$abs" 2>/dev/null \
      | awk -F'\t' '$1=="VC" && $3=="ensures"' > "$proof.records" || true
    # run z3 on each ensures query; keep the line when unsat (proven)
    : > "$proof"
    local tmpq
    tmpq="$(mktemp)"
    while IFS=$'\t' read -r _tag line _kind _clause query; do
      [[ "$query" == "RESIDUAL" ]] && continue
      printf '%s\n' "$query" > "$tmpq"
      if [[ "$(bash "$ROOT/scripts/sv0-z3.sh" "$tmpq" 2>/dev/null | head -1)" == "unsat" ]]; then
        printf '%s\n' "$line" >> "$proof"
      fi
    done < "$proof.records"
    rm -f "$tmpq" "$proof.records"
  else
    sv0_info "emit-verified: z3 not on PATH — nothing proven, all checks kept" >&2
    : > "$proof"
  fi
  # pass 2: compile with the proven ensures stripped
  printf '%s\n' "--verified $proof $abs" > /tmp/.sv0_drv_path
  local ec=0
  "$ROOT/build/sv0-megatu-native" || ec=$?
  printf '' > /tmp/.sv0_drv_path
  rm -f "$proof"
  return "$ec"
}

# M4-S-025: `sv0 compile [--contract-mode=runtime|verified|disabled] <file>` — emit C
# honoring the contract mode. Precedence: explicit flag > `[build] contract-mode`
# in an sv0.toml beside <file> > default `runtime`. runtime keeps all checks;
# verified strips the proven ensures (runs `sv0 verify` first); disabled strips
# every contract check. C to stdout.
run_compile() {
  local flag_mode="$1"
  local file="$2"
  [[ -f "$file" ]] || sv0_fail "compile: no such file: $file"
  local mode="$flag_mode"
  if [[ -z "$mode" ]]; then
    local toml
    toml="$(cd "$(dirname "$file")" && pwd)/sv0.toml"
    mode="$(python3 "$ROOT/scripts/sv0_contract_mode.py" "$toml" 2>/dev/null || true)"
  fi
  [[ -z "$mode" ]] && mode="runtime"
  case "$mode" in
    runtime | verified | disabled) ;;
    *) sv0_fail "compile: unknown contract-mode '$mode' (want runtime|verified|disabled)" ;;
  esac
  if [[ "$mode" == "verified" ]]; then
    run_emit_verified "$file"
    return $?
  fi
  ensure_sv0_megatu_native
  local abs
  abs="$(cd "$(dirname "$file")" && pwd)/$(basename "$file")"
  if [[ "$mode" == "disabled" ]]; then
    printf '%s\n' "--disabled $abs" > /tmp/.sv0_drv_path
  else
    printf '%s\n' "$abs" > /tmp/.sv0_drv_path
  fi
  local ec=0
  "$ROOT/build/sv0-megatu-native" || ec=$?
  printf '' > /tmp/.sv0_drv_path
  return "$ec"
}

_abs_sv0c_rel() {
  local rel="${1:?}"
  local p="$SV0C/$rel"
  if [[ "$p" != /* ]]; then
    p="$(cd "$(dirname "$p")" && pwd)/$(basename "$p")"
  fi
  printf '%s' "$p"
}

# Reference emit for self-host loop diff leg — direct SML heap image (not SV0_SELF_HOST_COMPILER).
_self_host_emit_c_via_sml_heap_to() {
  local rel="${1:?}"
  local out="${2:?}"
  local log
  log="$(mktemp)"
  if [[ ! -f "$SV0C/$rel" ]]; then
    rm -f "$log"
    return 1
  fi
  set +e
  (cd "$SV0C" && sml "@SMLload=build/sv0c" "$rel" >"$out" 2>"$log")
  local sml_ec=$?
  set -e
  if [[ "$sml_ec" -ne 0 ]] || grep -q 'Error:' "$log"; then
    tail -30 "$log" >&2
    rm -f "$log"
    return 1
  fi
  rm -f "$log"
  if ! grep -q '#include' "$out"; then
    echo "self-host: emitted file missing #include: $out" >&2
    return 1
  fi
  return 0
}

check_sv0c() {
  require_sml
  if ! bash "$ROOT/scripts/sv0-smoke-self-host-compiler.sh"; then
    sv0_fail "sv0c: heap + SV0_SELF_HOST_COMPILER smoke failed"
  fi
  sv0_ok "sv0c: heap + emit smoke (sv0c/scripts/smoke-self-host-compiler.sh; make legacy-bootstrap-check for full CM.make)"
}

check_sv0vm() {
  require_sml
  local log
  log="$(mktemp)"
  if ! ( cd "$SV0VM" && echo 'use "src/main.sml"; OS.Process.exit OS.Process.success;' | sml >"$log" 2>&1 ); then
    tail -50 "$log"
    rm -f "$log"
    sv0_fail "sv0vm: sml exited non-zero"
  fi
  sml_log_check "sv0vm" "$log"
  sv0_ok "sv0vm: interpreter loads"
}

run_check() {
  ensure_sv0_self_host_compiler
  export SV0_SELF_HOST_COMPILER="${SV0_SELF_HOST_COMPILER:-$ROOT/build/sv0-self-host-compiler}"
  check_sv0c
  check_sv0vm
}

# Python regression guards also run inside run_test; exposed as `sv0 test-guards` for fast iteration.
run_python_guards() {
  local label="${1:-sv0}"
  local ec=0
  sv0_require_cmd python3
  sv0_info "$label: .sv0 block-comment nesting guard"
  if ! python3 "$ROOT/scripts/check_sv0_block_comment_nesting.py"; then
    ec=1
  fi
  sv0_info "$label: sv0doc baseline (milestone 0 paths)"
  if ! python3 "$ROOT/scripts/verify_sv0doc_baseline.py" --root "$ROOT"; then
    ec=1
  fi
  sv0_info "$label: task/*.Rmd YAML front matter (graph-safe keys)"
  if ! python3 "$ROOT/scripts/verify_task_rmd_frontmatter.py" --root "$ROOT"; then
    ec=1
  fi
  sv0_info "$label: task/*.Rmd optional sv0-track anchors + checklist ingestion"
  if ! python3 "$ROOT/scripts/verify_task_rmd_tracking.py" --root "$ROOT"; then
    ec=1
  fi
  sv0_info "$label: README.md sv0c pinned SHA vs git submodule (index or HEAD)"
  if ! python3 "$ROOT/scripts/verify_readme_sv0c_gitlink.py" --root "$ROOT"; then
    ec=1
  fi
  sv0_info "$label: vm-parity manifest ⊆ sv0c/lib/bootstrap-sources.list"
  if ! python3 "$ROOT/scripts/verify_vm_parity_manifest_bootstrap.py" --root "$ROOT"; then
    ec=1
  fi
  sv0_info "$label: task/milestone-orientation.json (schema + primary_tasks exist)"
  if ! python3 "$ROOT/scripts/verify_milestone_orientation.py" --root "$ROOT"; then
    ec=1
  fi
  sv0_info "$label: workspace milestone table cites all milestone-orientation primary_tasks"
  if ! python3 "$ROOT/scripts/verify_workspace_milestone_table.py" --root "$ROOT"; then
    ec=1
  fi
  sv0_info "$label: compiler .sv0 (lib/lexer/parser) must not use \`raise\` (M3-S-014)"
  if ! python3 "$ROOT/scripts/verify_compiler_sv0_no_raise.py" --root "$ROOT"; then
    ec=1
  fi
  sv0_info "$label: commit-msg AI-signoff checker selftest (git-hooks)"
  if ! python3 "$ROOT/scripts/verify_commit_msg_no_ai_signoff.py" --selftest; then
    ec=1
  fi
  sv0_info "$label: M3 G1 Track C per-slice path audit (scripts/m3_g1_active_slices.txt)"
  if ! python3 "$ROOT/scripts/verify_m3_g1_track_c.py" --root "$ROOT"; then
    ec=1
  fi
  sv0_info "$label: M3 G6 pipeline contract (lib/main.sv0 DRIVER_FULL_PIPELINE_LEN vs PHASE_COUNT)"
  if ! python3 "$ROOT/scripts/verify_m3_g6_pipeline_contract.py" --root "$ROOT"; then
    ec=1
  fi
  sv0_info "$label: M3 G6 link merge contract (lib/link.sv0 token-stream merge helpers)"
  if ! python3 "$ROOT/scripts/verify_m3_g6_link_merge_contract.py" --root "$ROOT"; then
    ec=1
  fi
  sv0_info "$label: M3 G6 staging driver contract (sources.cm + main.sv0 staging spine)"
  if ! python3 "$ROOT/scripts/verify_m3_g6_staging_driver_contract.py" --root "$ROOT"; then
    ec=1
  fi
  sv0_info "$label: M3 G7 diagnostics corpus layout (sv0c/test/diagnostics)"
  if ! python3 "$ROOT/scripts/verify_diagnostics_corpus_layout.py" --root "$ROOT"; then
    ec=1
  fi
  sv0_info "$label: M3 G7 tier-2 VM parity policy (tier2-manifest vs manifest + goldens)"
  if ! python3 "$ROOT/scripts/verify_vm_parity_tier2_policy.py" --root "$ROOT"; then
    ec=1
  fi
  sv0_info "$label: M3 G8 native self-host recipe paths (build script + doc)"
  if ! python3 "$ROOT/scripts/verify_m3_g8_native_recipe_paths.py" --root "$ROOT"; then
    ec=1
  fi
