  sv0_require_file "$SV0DOC/bytecode/instructions.md"
  sv0_require_dir "$SV0_MCP"
  sv0_require_file "$SV0_MCP/README.md"
  python3 "$ROOT/scripts/gen_sv0_doc.py" --root "$ROOT"
  sv0_ok "sv0 doc: generated build/sv0-toolchain-doc/index.md; sv0doc + sv0-mcp paths OK"
}

run_fmt_sv0() {
  sv0_require_cmd python3
  python3 "$ROOT/scripts/fmt_sv0.py" "$SV0C" "$SV0VM"
  sv0_ok "fmt: .sv0 whitespace normalization under sv0c/ and sv0vm/"
}

run_fmt() {
  run_fmt_sv0
  run_fmt_shell
}

run_fmt_shell() {
  local f
  local fmt_targets=(
    "$ROOT/scripts/sv0"
    "$ROOT/scripts/sv0-smoke-self-host-compiler.sh"
    "$ROOT/scripts/sv0-self-host-emit-c.sh"
    "$ROOT/scripts/with-github-ssh443.sh"
    "$ROOT/scripts/ci-install-smlnj.sh"
    "$ROOT/lib/shell/common.sh"
    "$ROOT/lib/sml/build-helpers.sh"
    "$ROOT/task/sv0vm-milestone-2/01-verify-setup.sh"
    "$ROOT/task/sv0vm-milestone-2/02-integration-test.sh"
    "$ROOT/task/sv0c-milestone-1/01-verify-sml-setup.sh"
    "$ROOT/task/sv0c-milestone-1/02-integration-test.sh"
    "$ROOT/task/sv0-toolchain-workspace/01-verify-submodules.sh"
    "$ROOT/task/sv0-mcp-milestone-0/01-verify-package.sh"
  )
  for f in "${fmt_targets[@]}"; do
    [[ -f "$f" ]] || continue
    bash -n "$f" || sv0_fail "bash -n failed: $f"
  done
  if command -v shfmt >/dev/null 2>&1; then
    local existing=()
    for f in "${fmt_targets[@]}"; do
      [[ -f "$f" ]] && existing+=("$f")
    done
    if ((${#existing[@]} > 0)); then
      shfmt -i 2 -w "${existing[@]}"
    fi
    sv0_ok "shfmt applied"
  else
    sv0_info "shfmt not installed; skipped write-format"
  fi
  sv0_ok "fmt-shell: bash syntax OK"
}

run_ci() {
  run_check
  run_test
  sv0_ok "ci: SML-only (check + full sv0 test harness) passed"
}

run_ci_all() {
  run_ci
  run_test_mcp
  sv0_ok "ci-all: SML ci + sv0-mcp (pytest when uv is available)"
}

run_milestone_orient() {
  sv0_require_cmd python3
  local sub="${1:-}"
  if [[ -z "$sub" ]]; then
    python3 "$ROOT/scripts/milestone_orient.py" list
    return 0
  fi
  if [[ "$sub" == "list" ]]; then
    python3 "$ROOT/scripts/milestone_orient.py" list
    return 0
  fi
  if [[ "$sub" == "show" ]]; then
    shift || true
    local mid="${1:-}"
    if [[ -z "$mid" ]]; then
      echo "sv0 milestone-orient show: missing milestone id (e.g. M3, mcp-0)" >&2
      exit 1
    fi
    python3 "$ROOT/scripts/milestone_orient.py" show "$mid"
    return 0
  fi
  if [[ "$sub" == "-h" || "$sub" == "--help" ]]; then
    cat >&2 <<'EOF'
usage: sv0 milestone-orient [list | show <id> | <id>]

  list          print all milestone ids and owning task/*.Rmd entrypoints
  show <id>     print tasks, validation hints, closure authority, anti-patterns
  <id>          shorthand for show <id>

Data: task/milestone-orientation.json — completion criteria remain in the linked task files.
EOF
    return 0
  fi
  python3 "$ROOT/scripts/milestone_orient.py" show "$sub"
}

run_progress_dashboard() {
  sv0_require_cmd python3
  local port="${1:-8765}"
  local refresh="${SV0_PROGRESS_DASHBOARD_REFRESH:-120}"
  exec python3 "$ROOT/scripts/progress_dashboard_server.py" \
    --root "$ROOT" --port "$port" --refresh-seconds "$refresh"
}

run_mcp_light_stack() {
  sv0_require_cmd docker
  sv0_require_dir "$SV0_MCP"
  local sub="${1:-up}"
  local mount_root="${SV0_MCP_TOOLCHAIN_ROOT:-$ROOT}"
  if [[ "$sub" == "down" ]]; then
    (cd "$SV0_MCP" && SV0_MCP_TOOLCHAIN_ROOT="$mount_root" docker compose down) || exit 1
    return 0
  fi
  if [[ "$sub" != "up" ]]; then
    echo "sv0 mcp-light-stack: unknown subcommand '$sub' (use up or down)" >&2
    exit 1
  fi
  local refresh="${SV0_MCP_PROGRESS_DASHBOARD_REFRESH:-300}"
  (
    cd "$SV0_MCP" || exit 1
    export SV0_MCP_TOOLCHAIN_ROOT="$mount_root"
    export SV0_MCP_PROGRESS_DASHBOARD_REFRESH="$refresh"
    docker compose up -d
  ) || exit 1
}

run_repl() {
  require_sml
  mkdir -p "$SV0C/build/vm"
  local src="$SV0C/build/repl_line.sv0"
  echo "sv0 repl (bytecode VM). Enter an i32 expression (e.g. 2 + 2) or a println(\"...\") call." >&2
  echo "main's exit code is printed as the expression result. :q or EOF quits." >&2
  while true; do
    read -r -p "> " line || {
      echo >&2
      break
    }
    [[ -z "${line//[[:space:]]/}" ]] && continue
    case "$line" in
      :q | :quit) break ;;
    esac
    if [[ "$line" =~ ^[[:space:]]*println\( ]]; then
      local stmt="$line"
      [[ "$stmt" != *';' ]] && stmt="${stmt};"
      cat >"$src" <<EOF
fn main() -> unit {
  ${stmt}
}
EOF
    else
      cat >"$src" <<EOF
fn main() -> i32 {
  return (${line});
}
EOF
    fi
    local log
    log="$(mktemp)"
    if ! (cd "$SV0C" && echo "CM.make \"sources.cm\"; OS.Process.exit(Main.main ((), [\"--target=vm\", \"build/repl_line.sv0\"]));" | sml >"$log" 2>&1); then
      echo "compile error:" >&2
      tail -20 "$log" >&2
      rm -f "$log"
      continue
    fi
    if grep -q 'Error:' "$log"; then
      echo "compile error:" >&2
      tail -20 "$log" >&2
      rm -f "$log"
      continue
    fi
    rm -f "$log"
    local sv0b="$SV0C/build/vm/repl_line.sv0b"
    if [[ ! -f "$sv0b" ]]; then
      echo "no bytecode emitted" >&2
      continue
    fi
    local out
    out="$(cd "$SV0VM" && SV0B="$sv0b" sml < scripts/run_sv0b.sml 2>&1)" || true
    local ev
    ev="$(echo "$out" | grep -E '^vm_exit:' | tail -1 | sed 's/^vm_exit://')"
    echo "$out" | awk '/^SV0VM_RUN_BEGIN$/ {p=1; next} /^vm_exit:/ {p=0; next} p && !/^val exitCode =/ {print}' || true
    if [[ -n "$ev" ]]; then
      echo "=> exit ${ev}" >&2
    fi
  done
}

cmd="${1:-}"
shift || true

case "$cmd" in
  check|build)
    run_check
    ;;
  test)
    run_test
    ;;
  test-guards)
    if [[ "${1:-}" == "--fast" ]]; then export SV0_GUARDS_FAST=1; fi
    run_test_guards
    ;;
  test-light)
    run_test_light "$@"
    ;;
  test-mcp)
    run_test_mcp
    ;;
  doc)
    run_doc
    ;;
  doctest)
    run_doctests
    ;;
  fmt)
    run_fmt
    ;;
  fmt-shell)
    run_fmt_shell
    ;;
  bootstrap-build)
    run_bootstrap_build || exit 1
    ;;
  emit-c)
    rel="${1:-}"
    if [[ -z "$rel" ]]; then usage; exit 1; fi
    run_emit_c "$rel"
    ;;
  compile-run)
    rel="${1:-}"
    if [[ -z "$rel" ]]; then usage; exit 1; fi
    run_compile_run "$rel"
    ;;
  verify)
    verify_json=0
    if [[ "${1:-}" == "--json" ]]; then
      verify_json=1
      shift
    fi
    file="${1:-}"
    if [[ -z "$file" ]]; then usage; exit 1; fi
    run_verify "$file" "$verify_json"
    ;;
  emit-verified)
    file="${1:-}"
    if [[ -z "$file" ]]; then usage; exit 1; fi
    run_emit_verified "$file"
    ;;
  compile)
    compile_mode=""
    if [[ "${1:-}" == --contract-mode=* ]]; then
      compile_mode="${1#--contract-mode=}"
      shift
    fi
    file="${1:-}"
    if [[ -z "$file" ]]; then usage; exit 1; fi
    run_compile "$compile_mode" "$file"
    ;;
  native-compile)
    python3 "$ROOT/scripts/native_exe_main.py" "$@"
    exit $?
    ;;
  self-host-capture-stage0)
    rel="${1:-}"
    if [[ -z "$rel" ]]; then usage; exit 1; fi
    run_self_host_capture_stage0 "$rel"
    ;;
  self-host-compare)
    stem="${1:-}"
    if [[ -z "$stem" ]]; then usage; exit 1; fi
    run_self_host_compare "$stem"
    ;;
  self-host-check-golden)
    run_self_host_stage0_golden || exit 1
    ;;
  self-host-sv0-loop)
    run_self_host_sv0_loop || exit 1
    ;;
  run-cache-selftest)
    run_cache_selftest
    ;;
  __self-host-loop-one)
    # Hidden: one parallel worker of run_self_host_sv0_loop, dispatched via
    # xargs -P against a fresh `sv0` invocation per file. Not a public command.
    rel="${1:-}"
    if [[ -z "$rel" ]]; then usage; exit 1; fi
    _self_host_sv0_loop_one "$rel"
    ;;
  build-self-host-compiler)
    bash "$ROOT/scripts/build-sv0-self-host-compiler.sh"
    ;;
  self-host-native-parity)
    bash "$ROOT/scripts/sv0-native-behavioral-parity.sh"
    ;;
  vm-parity-tier2-emit)
    # Tier-2 VM byte-parity: re-emit each tier2-manifest path via
    # SV0_VM_BYTECODE_EMITTER and cmp to golden/sml/<stem>.sv0b. Defaults the
    # emitter to the native mega-TU VM emitter wrapper when the env is unset, so
    # `sv0 vm-parity-tier2-emit` is a self-contained byte-parity gate.
    : "${SV0_VM_BYTECODE_EMITTER:=$ROOT/scripts/sv0-vm-tier2-native-emitter.sh}"
    export SV0_VM_BYTECODE_EMITTER
    run_vm_parity_tier2_emit_compare
    ;;
  vm-behavioral-parity)
    # VMF-018: run each behavioral-manifest.txt fixture through BOTH native
    # backends (emit-c->cc->run and VM-emit->sv0vm) and compare exit codes.
    # The f64 / i64 surface has no SML --target=vm reference, so this is the
    # cross-backend evidence there (COMPAT-001/002 for sv0-mathlib).
    require_sml
    python3 "$ROOT/scripts/vm_behavioral_parity.py"
    ;;
  assemble-megatu)
    python3 "$ROOT/scripts/assemble-sv0-megaTU.py" --root "$ROOT" "$@"
    ;;
  sml-retirement-preflight)
    python3 "$ROOT/scripts/sml_retirement_preflight_scan.py" --root "$ROOT"
    ;;
  integration-vm)
    bash "$ROOT/task/sv0vm-milestone-2/02-integration-test.sh"
    ;;
  vm-compile)
    rel="${1:-}"
    if [[ -z "$rel" ]]; then usage; exit 1; fi
    (cd "$SV0C" && echo "CM.make \"sources.cm\"; OS.Process.exit(Main.main ((), [\"--target=vm\", \"$rel\"]));" | sml)
    ;;
  vm-project-compile)
    rel="${1:-}"
    if [[ -z "$rel" ]]; then usage; exit 1; fi
    if [[ ! -d "$SV0C/$rel" ]]; then
      echo "sv0: vm-project-compile: not a directory under sv0c: $rel" >&2
      exit 1
    fi
    (cd "$SV0C" && echo "CM.make \"sources.cm\"; OS.Process.exit(Main.main ((), [\"--target=vm\", \"--project\", \"$rel\"]));" | sml)
    ;;
  vm-native-compile)
    # VMF-015: emit .sv0b via the NATIVE mega-TU VM emitter (no SML at runtime;
    # the path that supports f64 / i64 / wide-int -- see sv0c-vm-float-parity).
    #   vm-native-compile <file.sv0> [out.sv0b]
    #   vm-native-compile --project <dir> [out.sv0b]
    #   [--coverage=off|map|instrument] [--coverage-map <path>] anywhere
    # Absolute paths accepted (unlike vm-compile). Builds build/sv0-megatu-vm-native
    # when it is missing or older than the compiler sources or runtime
    # (_artifact_stale), like the native compiler.
    _vmn="$ROOT/build/sv0-megatu-vm-native"
    if [[ ! -x "$_vmn" ]] || _artifact_stale "$_vmn" \
         "$ROOT/scripts/build-sv0-megatu-vm-native.sh" "$ROOT/scripts/assemble-sv0-megaTU.py"; then
      bash "$ROOT/scripts/build-sv0-megatu-vm-native.sh" >&2
    fi
    [[ -x "$_vmn" ]] || { echo "sv0: vm-native-compile: emitter build failed" >&2; exit 1; }
    # SS-U10 (sv0-strings SPEC UP-028 / OQ-012): the native VM backend runs
    # contracts in 'runtime' mode only. Recognise --contract-mode=<X> anywhere
    # in the args -- accept 'runtime', refuse 'verified'/'disabled' as
    # unsupported rather than mis-consuming the flag as an output path (the
    # docs/BUGS.md #6 repro), reject anything else as unknown.
    # sv0cov CV-106: --coverage=off|map|instrument and --coverage-map <path>
    # (SPEC 13.3), resolved by scripts/native_exe_coverage.py like the native
    # driver; a non-off mode reaches the emitter in SV0_COVERAGE_REQUEST.
    _vm_args=()
    _vm_cmode=""
    _vm_cov=""
    _vm_covmap=""
    _vm_covmap_seen=0
    while (($# > 0)); do
      case "$1" in
        --contract-mode=*) _vm_cmode="${1#--contract-mode=}" ;;
        --coverage=*)
          [[ -z "$_vm_cov" ]] || { echo "sv0: vm-native-compile: repeated option: --coverage" >&2; exit 2; }
          _vm_cov="${1#--coverage=}"
          [[ -n "$_vm_cov" ]] || { echo "sv0: vm-native-compile: option --coverage requires a value" >&2; exit 2; } ;;
        --coverage-map)
          ((_vm_covmap_seen == 0)) || { echo "sv0: vm-native-compile: repeated option: --coverage-map" >&2; exit 2; }
          (($# > 1)) || { echo "sv0: vm-native-compile: option --coverage-map requires a value" >&2; exit 2; }
          _vm_covmap_seen=1
          _vm_covmap="$2"
          shift ;;
        *) _vm_args+=("$1") ;;
      esac
      shift
    done
    case "$_vm_cmode" in
      ""|runtime) ;;
      verified|disabled)
        echo "sv0: vm-native-compile: --contract-mode=$_vm_cmode is unsupported on the native VM backend" >&2
        echo "sv0: vm-native-compile: the VM runs contracts in 'runtime' mode only (use the C backend for verified/disabled)" >&2
        exit 2 ;;
      *)
        echo "sv0: vm-native-compile: unknown contract-mode '$_vm_cmode' (want runtime|verified|disabled)" >&2
        exit 2 ;;
    esac
    set -- ${_vm_args[@]+"${_vm_args[@]}"}
    if [[ "${1:-}" == "--project" ]]; then
      _d="${2:-}"
      [[ -n "$_d" && -d "$_d" ]] || { echo "sv0: vm-native-compile --project <dir>: not a directory: ${2:-}" >&2; exit 1; }
      _d="$(cd "$_d" && pwd)"
      _out="${3:-$ROOT/build/vm/$(basename "$_d").sv0b}"
      _vm_req="--project $_d"
    else
      _f="${1:-}"
      [[ -n "$_f" && -f "$_f" ]] || { echo "sv0: vm-native-compile <file.sv0>: not a file: ${1:-}" >&2; exit 1; }
      _f="$(cd "$(dirname "$_f")" && pwd)/$(basename "$_f")"
      _out="${2:-$ROOT/build/vm/$(basename "$_f" .sv0).sv0b}"
      _vm_req="$_f"
    fi
    _cov_args=(--mode "${_vm_cov:-off}" --artifact "$_out")
    ((_vm_covmap_seen == 0)) || _cov_args+=(--map "$_vm_covmap")
    _cov_req="$(python3 "$ROOT/scripts/native_exe_coverage.py" resolve "${_cov_args[@]}")" || exit 2
    mkdir -p "$(dirname "$_out")"
    # Publish through a temp file so a failed compile leaves no partial .sv0b.
    _vm_tmp="$_out.tmp.$$"
    if [[ -n "$_cov_req" ]]; then
      _vm_rc=0; SV0_COVERAGE_REQUEST="$_cov_req" SV0_DRV_REQUEST="$_vm_req" "$_vmn" > "$_vm_tmp" || _vm_rc=$?
    else
      _vm_rc=0; env -u SV0_COVERAGE_REQUEST SV0_DRV_REQUEST="$_vm_req" "$_vmn" > "$_vm_tmp" || _vm_rc=$?
    fi
    if ((_vm_rc != 0)); then rm -f "$_vm_tmp"; exit "$_vm_rc"; fi
    mv -f "$_vm_tmp" "$_out"
    echo "sv0: vm-native-compile: wrote $_out" >&2
    ;;
  vm-run)
    sv0b="${1:-}"
    if [[ -z "$sv0b" ]]; then usage; exit 1; fi
    # run_sv0b.sml opens SV0B relative to sv0vm cwd; resolve repo-root paths (e.g. sv0c/build/vm/foo.sv0b)
    if [[ "$sv0b" != /* ]] && [[ ! -f "$SV0VM/$sv0b" ]]; then
      if [[ -f "$ROOT/$sv0b" ]]; then
        sv0b="$ROOT/$sv0b"
      fi
    fi
    (cd "$SV0VM" && SV0B="$sv0b" sml < scripts/run_sv0b.sml)
    ;;
  repl)
    run_repl
    ;;
  ci)
    run_ci
    ;;
  ci-all)
    run_ci_all
    ;;
  milestone-orient)
    run_milestone_orient "$@"
    ;;
  mcp-light-stack)
    shift || true
    run_mcp_light_stack "${1:-up}"
    ;;
  progress-dashboard)
    run_progress_dashboard "$@"
    ;;
  ""|-h|--help)
    usage
    exit 0
    ;;
  *)
    echo "sv0: unknown command: $cmd" >&2
    usage
    exit 1
    ;;
esac
